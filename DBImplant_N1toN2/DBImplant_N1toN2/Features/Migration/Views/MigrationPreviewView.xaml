<UserControl x:Class="DBImplant_N1toN2.Features.Migration.Views.MigrationPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:migvm="clr-namespace:DBImplant_N1toN2.Features.Migration.ViewModels"
             d:DataContext="{d:DesignInstance Type=migvm:MigrationPreviewViewModel}"
             mc:Ignorable="d">

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── 헤더 ── -->
            <DockPanel Grid.Row="0" Background="#1e1e2e" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" FontWeight="Bold"
                        Width="36" Height="28" Margin="4"
                        Command="{Binding CloseCommand}"
                        Background="Transparent" Foreground="#cc6666"
                        BorderThickness="0" Cursor="Hand"/>
                <TextBlock Text="Migration Preview — 소스→타겟 매핑 + 파일 이동 미리보기"
                           FontWeight="Bold" Foreground="#ccccee" FontSize="14"
                           VerticalAlignment="Center" Margin="12,8"/>
            </DockPanel>

            <!-- ── 2탭 본문 ── -->
            <TabControl Grid.Row="1" Margin="4">

                <!-- 탭 1: DB 컬럼 매핑 -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="DB 컬럼 매핑" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding DbSummary}" Foreground="Gray" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 필터 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="테이블 필터:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding DbAvailableTables}"
                                      SelectedItem="{Binding DbSelectedTable}"
                                      Width="200" IsEditable="False"/>
                            <Button Content="전체 보기" Margin="8,0,0,0" Padding="8,2"
                                    Command="{Binding CloseCommand}"
                                    Visibility="Collapsed"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding DbFilteredRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="True" CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Target Table"   Binding="{Binding TargetTable}"  Width="140"/>
                                <DataGridTextColumn Header="Target Column"  Binding="{Binding TargetColumn}" Width="140"/>
                                <DataGridTextColumn Header="Source Type"    Binding="{Binding SourceType}"   Width="80"/>
                                <DataGridTextColumn Header="Source Path"    Binding="{Binding SourcePath}"   Width="200"/>
                                <DataGridTextColumn Header="Sample Value"   Binding="{Binding SampleValue}"  Width="150"/>
                                <DataGridTextColumn Header="SQL Type"       Binding="{Binding SqlDataType}"  Width="120"/>
                                <DataGridTextColumn Header="Note"           Binding="{Binding Note}"         Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 탭 2: 파일 이동 매핑 -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="파일 이동 매핑" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding FileSummary}" Foreground="Gray" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 카테고리 필터 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="카테고리:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding FileCategories}"
                                      SelectedItem="{Binding FileSelectedCategory}"
                                      Width="200" IsEditable="False"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding FileFilteredRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="True" CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="카테고리"      Binding="{Binding Category}"     Width="100"/>
                                <DataGridTextColumn Header="패키지/임무"   Binding="{Binding PackageName}"  Width="150"/>
                                <DataGridTextColumn Header="소스 파일"     Binding="{Binding SourceFile}"   Width="250"/>
                                <DataGridTextColumn Header="파일유형"      Binding="{Binding FileType}"     Width="60"/>
                                <DataGridTextColumn Header="대상 테이블"   Binding="{Binding TargetTable}"  Width="140"/>
                                <DataGridTextColumn Header="이동 방식"     Binding="{Binding TargetAction}" Width="100"/>
                                <DataGridTextColumn Header="크기(B)"      Binding="{Binding FileSize, StringFormat=N0}" Width="90"/>
                                <DataGridTextColumn Header="비고"         Binding="{Binding Note}"         Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- 탭 3: INSERT 미리보기 (실제 파싱된 레코드) -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="INSERT 미리보기" FontWeight="SemiBold" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding InsertSummary}" Foreground="Gray" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="대상 테이블:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding InsertAvailableTables}"
                                      SelectedItem="{Binding InsertSelectedTable}"
                                      Width="240" IsEditable="False"/>
                            <TextBlock Text="  ※ 파일 브라우저에서 파싱한 데이터가 실제로 어떤 레코드로 INSERT되는지 보여줍니다."
                                       Foreground="Gray" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding InsertFilteredRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="True" CanUserResizeColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="대상 테이블"   Binding="{Binding TargetTable}"   Width="160"/>
                                <DataGridTextColumn Header="패키지"       Binding="{Binding SourcePackage}" Width="140"/>
                                <DataGridTextColumn Header="#"           Binding="{Binding RowIndex}"      Width="40"/>
                                <DataGridTextColumn Header="{Binding Col1Name, FallbackValue=Col1}" Width="110">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Col1Value"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{Binding Col2Name, FallbackValue=Col2}" Width="110">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Col2Value"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{Binding Col3Name, FallbackValue=Col3}" Width="110">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Col3Value"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{Binding Col4Name, FallbackValue=Col4}" Width="110">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Col4Value"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{Binding Col5Name, FallbackValue=Col5}" Width="110">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Col5Value"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{Binding Col6Name, FallbackValue=Col6}" Width="*">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Col6Value"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

            </TabControl>

            <!-- 로딩 오버레이 -->
            <Border Grid.RowSpan="2" Background="#80000000"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="미리보기 데이터 로딩 중..."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="White"/>
            </Border>
        </Grid>
    </Border>
</UserControl>

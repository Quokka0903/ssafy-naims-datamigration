<UserControl x:Class="DBImplant_N1toN2.Features.Migration.Views.MigrationExecuteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:migvm="clr-namespace:DBImplant_N1toN2.Features.Migration.ViewModels"
             d:DataContext="{d:DesignInstance Type=migvm:MigrationExecuteViewModel}"
             mc:Ignorable="d">

    <Grid Background="#80000000">
        <!-- Center card -->
        <Border MaxWidth="700" MaxHeight="600"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="White" CornerRadius="8"
                Padding="24" Margin="40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <!-- Phase 1: Not running, not complete — 입력 폼 -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="DB Migration 수행"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#1e1e2e" Margin="0,0,0,12"/>

                    <TextBlock Text="타겟 DB 연결 문자열:" FontSize="12" Foreground="#555" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TargetConnectionString, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" Padding="8,6"
                             AcceptsReturn="False"
                             TextWrapping="Wrap"
                             MinHeight="60" Margin="0,0,0,12"/>

                    <Button Content="연결 및 실행"
                            Command="{Binding RunCommand}"
                            HorizontalAlignment="Right"
                            Padding="20,8" FontSize="13" FontWeight="Bold"
                            Background="#2563eb" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <!-- Phase 2: Running -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="마이그레이션 진행 중..."
                               FontSize="16" FontWeight="Bold" Foreground="#1e1e2e" Margin="0,0,0,8"/>

                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Minimum="0" Maximum="100"
                                 Height="18" Margin="0,4"/>

                    <TextBlock Text="{Binding CurrentStepName}"
                               FontSize="12" Foreground="#555"/>

                    <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding LogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="11" Foreground="#444" TextWrapping="Wrap" Margin="0,1">
                                        <Run Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" Foreground="#999"/>
                                        <Run Text=" ["/><Run Text="{Binding Level}"/><Run Text="] "/>
                                        <Run Text="{Binding Message}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Button Content="취소"
                            Command="{Binding CancelCommand}"
                            HorizontalAlignment="Right"
                            Padding="16,6" FontSize="12"
                            Background="#dc2626" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <!-- Phase 3: Complete -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsComplete}" Value="True"/>
                                        <Condition Binding="{Binding IsRunning}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="완료"
                               FontSize="18" FontWeight="Bold" Foreground="#1e1e2e" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding ResultSummary}"
                               FontSize="13" TextWrapping="Wrap" Foreground="#333" Margin="0,0,0,12"/>

                    <Button Content="닫기"
                            Command="{Binding CloseCommand}"
                            HorizontalAlignment="Right"
                            Padding="20,8" FontSize="13"
                            Background="#374151" Foreground="White"
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

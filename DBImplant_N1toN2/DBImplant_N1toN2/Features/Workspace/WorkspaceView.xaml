<UserControl x:Class="DBImplant_N1toN2.Features.Workspace.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DBImplant_N1toN2.Features.Workspace"
             xmlns:db="clr-namespace:DBImplant_N1toN2.Features.DbBrowser"
             xmlns:fb="clr-namespace:DBImplant_N1toN2.Features.FileBrowser"
             xmlns:mig="clr-namespace:DBImplant_N1toN2.Features.Migration.Views"
             xmlns:migvm="clr-namespace:DBImplant_N1toN2.Features.Migration.ViewModels"
             xmlns:conv="clr-namespace:DBImplant_N1toN2.Infrastructure.Converters"
             d:DataContext="{d:DesignInstance Type=vm:WorkspaceViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 상단 툴바 ── -->
        <Border Grid.Row="0" Background="{DynamicResource ShellBackgroundBrush}" Padding="12,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}"
                           Foreground="{DynamicResource TextOnDarkSecondaryBrush}"
                           FontSize="13" VerticalAlignment="Center"/>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Migration Preview" Margin="0,0,8,0"
                            Style="{DynamicResource ButtonHeaderStyle}"
                            Command="{Binding ShowPreviewCommand}"/>
                    <Button Content="DB Migration 수행"
                            Style="{DynamicResource ButtonPrimaryStyle}"
                            Command="{Binding ShowExecuteCommand}"/>
                </StackPanel>

                <Border/> <!-- spacer -->
            </DockPanel>
        </Border>

        <!-- ── 메인 콘텐츠 (좌/우 분할) ── -->
        <Grid Grid.Row="1">
            <!-- Layer 0: DB Browser + File Browser -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <db:DbBrowserView Grid.Column="0" DataContext="{Binding DbBrowser}"/>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}" Cursor="SizeWE"/>

                <fb:FileBrowserView Grid.Column="2" DataContext="{Binding FileBrowser}"/>
            </Grid>

            <!-- Layer 1: Migration Preview 오버레이 -->
            <mig:MigrationPreviewView DataContext="{Binding MigrationPreview}"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- Layer 2: Migration Execute 오버레이 -->
            <mig:MigrationExecuteView DataContext="{Binding MigrationExecute}"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
        </Grid>
    </Grid>
</UserControl>

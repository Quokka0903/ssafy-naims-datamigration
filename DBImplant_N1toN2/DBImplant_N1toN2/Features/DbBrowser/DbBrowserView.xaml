<UserControl x:Class="DBImplant_N1toN2.Features.DbBrowser.DbBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DBImplant_N1toN2.Features.DbBrowser"
             xmlns:rb="clr-namespace:DBImplant_N1toN2.Features.DbBrowser"
             d:DataContext="{d:DesignInstance Type=vm:DbBrowserViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 루트 테이블 목록 -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="4" Margin="0,0,4,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="레거시 DB 테이블" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="4,4,4,8"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding DbTypeName}" Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="10" Margin="4,0,4,8"/>
                <ListBox ItemsSource="{Binding RootTableNames}"
                         SelectedItem="{Binding SelectedRootTable}"
                         Background="Transparent" Foreground="White"
                         BorderThickness="0" FontSize="12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3a4a7a"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 우측: FK 체인 패널 (가로 스크롤) -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}"
                       Foreground="#888888" FontSize="11" Margin="4,4,0,0"/>
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Panels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RelationPanelViewModel}">
                            <rb:RelationPanelView Width="380"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>

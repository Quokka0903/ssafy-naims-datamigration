<UserControl x:Class="DBImplant_N1toN2.Features.Setup.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DBImplant_N1toN2.Features.Setup"
             d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="900">

    <Grid Background="{DynamicResource ShellBackgroundBrush}"
          VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="{DynamicResource SidebarBackgroundBrush}"
                CornerRadius="12" Padding="48,40"
                MinWidth="640" MaxWidth="800"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Effect="{DynamicResource DropShadowSmall}">
            <StackPanel>
                <TextBlock Text="NAIMS Data Migration"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource TextOnDarkBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="레거시 DB 이관 도구 — 마이그레이션 준비"
                           FontSize="13" Foreground="{DynamicResource TextOnDarkSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,32"/>

                <TextBlock Text="1. 레거시 DB 유형" Foreground="{DynamicResource TextOnDarkSecondaryBrush}"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton Content="MsSQL" Foreground="{DynamicResource TextOnDarkBrush}"
                                 FontSize="14" IsChecked="{Binding IsMsSql}" Margin="0,0,24,0"/>
                    <RadioButton Content="Oracle" Foreground="{DynamicResource TextOnDarkBrush}"
                                 FontSize="14" IsChecked="{Binding IsOracle}"/>
                </StackPanel>

                <TextBlock Text="2. 접속 방식" Foreground="{DynamicResource TextOnDarkSecondaryBrush}"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <RadioButton Content="ODBC (기본)" Foreground="{DynamicResource TextOnDarkBrush}"
                                 FontSize="14" IsChecked="{Binding IsOdbc}" Margin="0,0,24,0"
                                 ToolTip="폐쇄망 현행. 각 PC 에 ODBC 드라이버/DSN 설치 필요."/>
                    <RadioButton Content="다이렉트 (라이브러리)" Foreground="{DynamicResource TextOnDarkBrush}"
                                 FontSize="14" IsChecked="{Binding IsDirect}"
                                 ToolTip="벤더 관리형 드라이버로 직접 접속(설치 불필요)."/>
                </StackPanel>

                <TextBlock Text="3. DB 연결 문자열" Foreground="{DynamicResource TextOnDarkSecondaryBrush}"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox Text="{Binding ConnectionString, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="12" Padding="8,6"
                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                         Background="{StaticResource SidebarHoverBrush}" Foreground="{DynamicResource TextOnDarkBrush}"
                         CaretBrush="{DynamicResource PrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         ToolTip="ODBC 예: Driver={ODBC Driver 17 for SQL Server};Server=localhost,1433;Database=NAIMS;Uid=..;Pwd=..;&#10;다이렉트 예: Server=localhost,1433; Database=NAIMS; Trusted_Connection=True; TrustServerCertificate=True;"
                         Margin="0,0,0,8"/>
                <Button Content="🔎 이 PC의 ODBC 드라이버 / DSN 목록" HorizontalAlignment="Left"
                        Padding="10,4" Margin="0,0,0,20" Click="OnBrowseOdbc"
                        Style="{DynamicResource ButtonOutlineStyle}"
                        ToolTip="설치된 ODBC 드라이버/등록된 DSN 을 조회해 접속문자열에 채웁니다. (ODBC 방식일 때)"/>

                <TextBlock Text="4. MSU 파일 경로" Foreground="{DynamicResource TextOnDarkSecondaryBrush}"
                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DockPanel Margin="0,0,0,24">
                    <Button Content="경로 선택" DockPanel.Dock="Right" Width="90"
                            Margin="8,0,0,0" Style="{DynamicResource ButtonOutlineStyle}"
                            Command="{Binding BrowseMsuPathCommand}"/>
                    <TextBox Text="{Binding MsuRootPath, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas" FontSize="12" Padding="8,6"
                             Background="{StaticResource SidebarHoverBrush}" Foreground="{DynamicResource TextOnDarkBrush}"
                             CaretBrush="{DynamicResource PrimaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             ToolTip="예: D:\MSU"/>
                </DockPanel>

                <Button Content="마이그레이션 준비" FontSize="16" FontWeight="Bold"
                        Padding="0,14" Margin="0,8,0,16"
                        Style="{DynamicResource ButtonPrimaryStyle}"
                        Command="{Binding PrepareCommand}"/>

                <TextBlock Text="{Binding StatusText}"
                           Foreground="{DynamicResource TextOnDarkSecondaryBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

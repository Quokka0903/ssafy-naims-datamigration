<Window x:Class="DBImplant_N1toN2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:setup="clr-namespace:DBImplant_N1toN2.Features.Setup"
        xmlns:ws="clr-namespace:DBImplant_N1toN2.Features.Workspace"
        xmlns:folder="clr-namespace:DBImplant_N1toN2.Features.FolderExplorer"
        xmlns:rawvm="clr-namespace:DBImplant_N1toN2.Features.Raw.ViewModels"
        xmlns:nbvm="clr-namespace:DBImplant_N1toN2.Features.NarrowBand.ViewModels"
        xmlns:sdvm="clr-namespace:DBImplant_N1toN2.Features.ShortPeriod.ViewModels"
        xmlns:conv="clr-namespace:DBImplant_N1toN2.Infrastructure.Converters"
        xmlns:beh="clr-namespace:DBImplant_N1toN2.Infrastructure.Behaviors"
        mc:Ignorable="d"
        Title="NAIMS Data Migration" Height="1080" Width="1920">

    <Window.Resources>

        <!-- ── 최상위 단계 전환 ── -->
        <DataTemplate DataType="{x:Type setup:SetupViewModel}">
            <setup:SetupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ws:WorkspaceViewModel}">
            <ws:WorkspaceView/>
        </DataTemplate>

        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>

        <!-- 1/2/4 탭: 폴더구조 파싱 뷰 -->
        <DataTemplate DataType="{x:Type folder:FolderTabViewModel}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="경로 선택" Width="90" Margin="0,0,8,0"
                                Command="{Binding SelectRootPathCommand}"/>
                        <Button Content="루트 로드" Width="90" Margin="0,0,8,0"
                                Command="{Binding LoadRootCommand}"/>
                        <Button Content="전체 인덱스 스캔" Width="130" Margin="0,0,8,0"
                                Command="{Binding BuildIndexCommand}"/>
                        <Button Content="취소" Width="70"
                                Command="{Binding CancelCommand}"/>

                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                                   Text="{Binding RootPath}" Opacity="0.8"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ProgressBar Width="260" Height="18" Minimum="0" Maximum="1"
                                     Value="{Binding Progress}" Margin="0,0,10,0"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="3.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tree -->
                    <Border Grid.Column="0" BorderBrush="#444" BorderThickness="1" CornerRadius="6" Padding="6">
                        <TreeView ItemsSource="{Binding Roots}"
                                  beh:TreeViewBehavior.SelectedItemChangedCommand="{Binding OnNodeSelectedCommand}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                    <!-- Right: selected folder details + full index -->
                    <TabControl Grid.Column="1" Margin="10,0,0,0">
                        <TabItem Header="선택 폴더 상세">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding SelectedPath}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                                <GroupBox Grid.Row="1" Header="하위 폴더(1-depth)" Margin="0,0,0,6">
                                    <DataGrid ItemsSource="{Binding SelectedSubDirs}" AutoGenerateColumns="False"
                                              IsReadOnly="True" EnableRowVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="220"/>
                                            <DataGridTextColumn Header="경로" Binding="{Binding FullPath}" Width="auto"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>

                                <GroupBox Grid.Row="2" Header="파일(1-depth)">
                                    <DataGrid ItemsSource="{Binding SelectedFiles}" AutoGenerateColumns="False"
                                              IsReadOnly="True" EnableRowVirtualization="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="220"/>
                                            <DataGridTextColumn Header="크기" Binding="{Binding Length}" Width="90"/>
                                            <DataGridTextColumn Header="수정" Binding="{Binding LastWriteTime}" Width="160"/>
                                            <DataGridTextColumn Header="경로" Binding="{Binding FullPath}" Width="auto"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>
                            </Grid>
                        </TabItem>

                        <TabItem Header="전체 인덱스(스캔 결과)">
                            <DataGrid ItemsSource="{Binding IndexRows}" AutoGenerateColumns="False"
                                      IsReadOnly="True" EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="폴더" Binding="{Binding FullPath}" Width="auto"/>
                                    <DataGridTextColumn Header="하위폴더수" Binding="{Binding SubDirCount}" Width="90"/>
                                    <DataGridTextColumn Header="파일수" Binding="{Binding FileCount}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type rawvm:RawTabViewModel}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="3.8*"/>
                </Grid.ColumnDefinitions>

                <!-- Top Bar -->
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="경로 선택" Width="90" Margin="0,0,8,0"
     Command="{Binding SelectRootPathCommand}"/>
                        <Button Content="스캔+파싱" Width="110" Margin="0,0,8,0"
     Command="{Binding ScanParseCommand}"/>
                        <Button Content="DB Import(TODO)" Width="130" Margin="0,0,8,0"
     Command="{Binding DbImportCommand}"/>
                        <Button Content="취소" Width="70" Margin="0,0,16,0"
     Command="{Binding CancelCommand}"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding RootPath}" Opacity="0.8"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ProgressBar Height="18" Width="300" Minimum="0" Maximum="1"
          Value="{Binding Progress}" Margin="0,0,10,0"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="3.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: package list -->
                    <DataGrid Grid.Column="0"
   ItemsSource="{Binding Packages}"
   SelectedItem="{Binding SelectedPackage}"
   AutoGenerateColumns="False"
   IsReadOnly="False"
   EnableRowVirtualization="True"
   VirtualizingPanel.IsVirtualizing="True"
   VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Import" Binding="{Binding IsChecked}" Width="auto"/>
                            <DataGridTextColumn Header="상태"   Binding="{Binding Status}"      IsReadOnly="True" Width="auto"/>
                            <DataGridTextColumn Header="패키지" Binding="{Binding DisplayName}"  IsReadOnly="True" Width="auto"/>
                            <DataGridTextColumn Header="에러"   Binding="{Binding Error}"        IsReadOnly="True" Width="auto"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Right: details -->
                    <TabControl Grid.Column="1" Margin="10,0,0,0">
                        <TabItem Header="Root WAV(Signal_*)">
                            <DataGrid ItemsSource="{Binding SelectedPackage.Sd.WavFiles}"
           AutoGenerateColumns="False"
           IsReadOnly="True"
           EnableRowVirtualization="True"
           VirtualizingPanel.IsVirtualizing="True"
           VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="파일" Binding="{Binding}" Width="auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="파싱 파일 목록">
                            <DataGrid
               ItemsSource="{Binding SelectedPackage.Files}"
               AutoGenerateColumns="False"
               IsReadOnly="True"
               EnableRowVirtualization="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="종류" Binding="{Binding Kind}" Width="auto"/>
                                    <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" Width="auto"/>
                                    <DataGridTextColumn Header="크기" Binding="{Binding Size}" Width="auto"/>
                                    <DataGridTextColumn Header="수정일" Binding="{Binding LastWriteTime}" Width="auto"/>
                                    <DataGridTextColumn Header="요약" Binding="{Binding Summary}" Width="auto"/>
                                    <DataGridTextColumn Header="에러" Binding="{Binding Error}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </DataTemplate>


        <DataTemplate DataType="{x:Type nbvm:NarrowBandTabViewModel}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="경로 선택" Width="90" Margin="0,0,8,0" Command="{Binding SelectRootPathCommand}"/>
                        <Button Content="스캔+파싱" Width="110" Margin="0,0,8,0" Command="{Binding ScanParseCommand}"/>
                        <Button Content="DB Import(TODO)" Width="130" Margin="0,0,8,0" Command="{Binding DbImportCommand}"/>
                        <Button Content="취소" Width="70" Margin="0,0,16,0" Command="{Binding CancelCommand}"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding RootPath}" Opacity="0.8"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ProgressBar Height="18" Width="300" Minimum="0" Maximum="1" Value="{Binding Progress}" Margin="0,0,10,0"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}"/>
                    </StackPanel>
                </DockPanel>

                <!-- 5 Columns -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="3.0*"/>
                        <ColumnDefinition Width="2.6*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1) Left: .nb package list -->
                    <!-- 1) Left: .nb package list + Selected ParsedAlg viewer (2 rows) -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <!-- 위: 패키지 목록 -->
                            <RowDefinition Height="2*"/>
                            <!-- 아래: .alg 전체 표시 -->
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>

                        <!-- (Row 0) 기존 폴더 리스트 -->
                        <DataGrid Grid.Row="0"
              ItemsSource="{Binding Packages}"
              SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              EnableRowVirtualization="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Import" Binding="{Binding IsChecked}" Width="auto"/>
                                <DataGridTextColumn Header="상태"    Binding="{Binding Status}"       IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="패키지"  Binding="{Binding PackageName}"   IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="RootWav" Binding="{Binding RootWavCount}"  IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="RootGrm" Binding="{Binding RootGrmCount}"  IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="정밀분석" Binding="{Binding HasPreciseDir}" IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="Snip"   Binding="{Binding Snippets.Count}"    IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="Tmp"    Binding="{Binding TmpSnippets.Count}" IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="에러"   Binding="{Binding Error}"             IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="경로"   Binding="{Binding NbDir}"             IsReadOnly="True" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- (Row 1) 선택 폴더의 ParsedAlg 전체 표시 -->
                        <GroupBox Grid.Row="1" Header="보조정보(.alg)" Margin="0,8,0,0">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 경로 / 에러(있으면) -->
                                <TextBlock Grid.Row="0"
                   Opacity="0.8"
                   Text="{Binding SelectedPackage.AlgPath, TargetNullValue=(alg 없음)}"/>

                                <TextBlock Grid.Row="1"
                   Margin="0,6,0,0"
                   Foreground="OrangeRed"
                   TextWrapping="Wrap"
                   Text="{Binding SelectedPackage.ParsedAlgError}"/>

                                <!-- 본문: ParsedAlg가 null이면 안내, 아니면 전체 정보 표시 -->
                                <ScrollViewer Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel DataContext="{Binding SelectedPackage}">
                                        <!-- Mission Info -->
                                        <GroupBox Header="MissionInfo" Margin="8">
                                            <UniformGrid Columns="2" Margin="8">
                                                <TextBlock Text="DetPlatform"/>
                                                <TextBlock Text="{Binding ParsedAlg.MissionInfo.DetPlatform}"/>

                                                <TextBlock Text="DetVesselClass"/>
                                                <TextBlock Text="{Binding ParsedAlg.MissionInfo.DetVesselClass}"/>

                                                <TextBlock Text="DetVesselName"/>
                                                <TextBlock Text="{Binding ParsedAlg.MissionInfo.DetVesselName}"/>

                                                <TextBlock Text="MissionDateFr"/>
                                                <TextBlock Text="{Binding ParsedAlg.MissionInfo.MissionDateFr}"/>

                                                <TextBlock Text="MissionDateTo"/>
                                                <TextBlock Text="{Binding ParsedAlg.MissionInfo.MissionDateTo}"/>

                                                <TextBlock Text="MissionSeaArea"/>
                                                <TextBlock Text="{Binding ParsedAlg.MissionInfo.MissionSeaArea}"/>

                                                <TextBlock Text="MissionSummary"/>
                                                <TextBlock Text="{Binding ParsedAlg.MissionInfo.MissionSummary}"/>

                                                <TextBlock Text="MissionComment"/>
                                                <TextBlock Text="{Binding ParsedAlg.MissionInfo.MissionComment}"/>
                                            </UniformGrid>
                                        </GroupBox>

                                        <!-- Recmedia -->
                                        <GroupBox Header="Recmedia" Margin="8">
                                            <ItemsControl Margin="8" ItemsSource="{Binding ParsedAlg.Recmedia}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Expander IsExpanded="False" Margin="0,0,0,8">
                                                            <Expander.Header>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Recmedia - RecordCount: " Opacity="0.8"/>
                                                                    <TextBlock Text="{Binding RecordCount}" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </Expander.Header>

                                                            <DataGrid ItemsSource="{Binding Records}"
                                              AutoGenerateColumns="True"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"/>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </GroupBox>

                                        <!-- NaviSea -->
                                        <GroupBox Header="Navi/Sea" Margin="8">
                                            <DataGrid Margin="8"
                              ItemsSource="{Binding ParsedAlg.NaviSeaInfos}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="DetDate" Binding="{Binding DetDate}" Width="auto"/>
                                                    <DataGridTextColumn Header="DetTime" Binding="{Binding DetTime}" Width="auto"/>
                                                    <DataGridTextColumn Header="Depth" Binding="{Binding Depth}" Width="auto"/>
                                                    <DataGridTextColumn Header="TADepth" Binding="{Binding TADepth}" Width="auto"/>
                                                    <DataGridTextColumn Header="Lat" Binding="{Binding Latitude}" Width="auto"/>
                                                    <DataGridTextColumn Header="Lon" Binding="{Binding Longitude}" Width="auto"/>
                                                    <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="auto"/>
                                                    <DataGridTextColumn Header="Situation" Binding="{Binding Situation}" Width="*"/>
                                                </DataGrid.Columns>

                                                <DataGrid.RowDetailsTemplate>
                                                    <DataTemplate>
                                                        <GroupBox Header="Temperatures" Margin="8">
                                                            <DataGrid ItemsSource="{Binding Temperatures}"
                                              AutoGenerateColumns="True"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"/>
                                                        </GroupBox>
                                                    </DataTemplate>
                                                </DataGrid.RowDetailsTemplate>
                                            </DataGrid>
                                        </GroupBox>

                                        <!-- Noise -->
                                        <GroupBox Header="Noise" Margin="8">
                                            <ItemsControl Margin="8" ItemsSource="{Binding ParsedAlg.NoiseInfos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Expander IsExpanded="False" Margin="0,0,0,8">
                                                            <Expander.Header>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="NoiseInfo - MachineCount: " Opacity="0.8"/>
                                                                    <TextBlock Text="{Binding MachineCount}" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </Expander.Header>

                                                            <DataGrid ItemsSource="{Binding Machines}"
                                              AutoGenerateColumns="True"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"/>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </GroupBox>

                                        <!-- Targets -->
                                        <GroupBox Header="Targets" Margin="8">
                                            <ItemsControl Margin="8" ItemsSource="{Binding ParsedAlg.TargetInfos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Expander IsExpanded="False" Margin="0,0,0,8">
                                                            <Expander.Header>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="TargetInfo - TargetCount: " Opacity="0.8"/>
                                                                    <TextBlock Text="{Binding TargetCount}" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </Expander.Header>

                                                            <DataGrid ItemsSource="{Binding Targets}"
                                              AutoGenerateColumns="True"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"/>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </GroupBox>

                                        <!-- NB Detection -->
                                        <GroupBox Header="NB Detection" Margin="8">
                                            <ItemsControl Margin="8" ItemsSource="{Binding ParsedAlg.NbDetectionInfos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Expander IsExpanded="False" Margin="0,0,0,8">
                                                            <Expander.Header>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="NbDetInfo - Count: " Opacity="0.8"/>
                                                                    <TextBlock Text="{Binding NbDetinfoCount}" FontWeight="SemiBold"/>
                                                                </StackPanel>
                                                            </Expander.Header>

                                                            <DataGrid ItemsSource="{Binding NbDetections}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False">
                                                                <DataGrid.Columns>
                                                                    <DataGridTextColumn Header="Target#" Binding="{Binding TargetNumber}" Width="auto"/>
                                                                    <DataGridTextColumn Header="DetTimeFr" Binding="{Binding DetTimeFr}" Width="auto"/>
                                                                    <DataGridTextColumn Header="DetTimeTo" Binding="{Binding DetTimeTo}" Width="auto"/>
                                                                    <DataGridTextColumn Header="Class" Binding="{Binding DetVesselClass}" Width="auto"/>
                                                                    <DataGridTextColumn Header="Name" Binding="{Binding DetVesselName}" Width="auto"/>
                                                                    <DataGridTextColumn Header="Dist" Binding="{Binding Distance}" Width="auto"/>
                                                                    <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="auto"/>
                                                                    <DataGridTextColumn Header="FeatureFreq" Binding="{Binding FeatureFreq}" Width="auto"/>
                                                                    <DataGridTextColumn Header="Machine" Binding="{Binding Machine}" Width="*"/>
                                                                </DataGrid.Columns>

                                                                <DataGrid.RowDetailsTemplate>
                                                                    <DataTemplate>
                                                                        <GroupBox Header="Indices" Margin="8">
                                                                            <DataGrid ItemsSource="{Binding Indices}"
                                                              AutoGenerateColumns="True"
                                                              IsReadOnly="True"
                                                              CanUserAddRows="False"/>
                                                                        </GroupBox>
                                                                    </DataTemplate>
                                                                </DataGrid.RowDetailsTemplate>
                                                            </DataGrid>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </GroupBox>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </GroupBox>


                    </Grid>



                    <!-- 2) Column2: Root files + Set parse summary (2 rows) -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>

                        <!-- Root file list -->
                        <GroupBox Grid.Row="0" Header="루트 파일 목록">
                            <DataGrid ItemsSource="{Binding SelectedPackage.RootItems}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="이름(상대)" Binding="{Binding RelativePath}" Width="auto"/>
                                    <DataGridTextColumn Header="Dir" Binding="{Binding IsDirectory}" Width="auto"/>
                                    <DataGridTextColumn Header="크기" Binding="{Binding Length}" Width="auto"/>
                                    <DataGridTextColumn Header="수정" Binding="{Binding LastWriteTime}" Width="auto"/>
                                    <DataGridTextColumn Header="전체경로" Binding="{Binding FullPath}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- Set file parsing summary -->
                        <GroupBox Grid.Row="1" Header="정밀신호처리파라미터.set" Margin="0,8,0,0">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 경로 / 에러 -->
                                <TextBlock Grid.Row="0" Margin="0,6,0,0" Foreground="OrangeRed"
                   Text="{Binding SelectedPackage.SetError}"
                   TextWrapping="Wrap"/>

                                <!-- 전체 내용 -->
                                <ScrollViewer Grid.Row="1" Margin="0,8,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>

                                        <!-- 공통 파라미터 -->
                                        <GroupBox Header="공통" Margin="0,0,0,8">
                                            <UniformGrid Columns="2" Margin="8">
                                                <TextBlock Text="SamplingFreq"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.SamplingFreq}"/>

                                                <TextBlock Text="LofarBand"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.LofarBand}"/>

                                                <TextBlock Text="WindowName"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.WindowName}"/>

                                                <TextBlock Text="KaiserBessel"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.KaiserBessel}"/>

                                                <TextBlock Text="Overlap"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.Overlap}"/>

                                                <TextBlock Text="FftSize(FromFile)"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.FftSizeFromFile}"/>

                                                <TextBlock Text="FftSize(Effective)"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.FftSizeEffective}"/>

                                                <TextBlock Text="NoiseNormalization"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.NoiseNormalizationName}"/>

                                                <TextBlock Text="WindowSize"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.WindowSize}"/>

                                                <TextBlock Text="WindowGapSize"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.WindowGapSize}"/>

                                                <TextBlock Text="ShearingThreshold"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.ShearingThreshold}"/>
                                            </UniformGrid>
                                        </GroupBox>

                                        <!-- 적분 -->
                                        <GroupBox Header="적분" Margin="0,0,0,8">
                                            <UniformGrid Columns="2" Margin="8">
                                                <TextBlock Text="LinearIntegrationTime"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.LinearIntegrationTime, StringFormat={}{0:F7}}"/>

                                                <TextBlock Text="LinearIntegrationNum"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.LinearIntegrationNum}"/>

                                                <TextBlock Text="ExpIntegrationTime"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.ExpIntegrationTime, StringFormat={}{0:F7}}"/>

                                                <TextBlock Text="ExpIntegrationNum"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.ExpIntegrationNum}"/>
                                            </UniformGrid>
                                        </GroupBox>

                                        <!-- Vernier (bandCount=4) -->
                                        <GroupBox Header="Vernier Bands (4)" Margin="0,0,0,8">
                                            <DataGrid Margin="8"
                              ItemsSource="{Binding SelectedPackage.ParsedSet.VernierParameters}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Band"      Binding="{Binding VernierBand, StringFormat={}{0:F7}}" Width="*"/>
                                                    <DataGridTextColumn Header="CenterHz"  Binding="{Binding CenterFreq,  StringFormat={}{0:F7}}" Width="*"/>
                                                    <DataGridTextColumn Header="StartHz"   Binding="{Binding StartFreq,   StringFormat={}{0:F7}}" Width="*"/>
                                                    <DataGridTextColumn Header="EndHz"     Binding="{Binding EndFreq,     StringFormat={}{0:F7}}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </GroupBox>

                                        <!-- Demon (bandCount=4) -->
                                        <GroupBox Header="Demon Bands (4)" Margin="0,0,0,8">
                                            <DataGrid Margin="8"
                              ItemsSource="{Binding SelectedPackage.ParsedSet.DemonParameters}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Band"       Binding="{Binding DemonBand,   StringFormat={}{0:F7}}" Width="*"/>
                                                    <DataGridTextColumn Header="CenterHz"   Binding="{Binding CenterFreq,  StringFormat={}{0:F7}}" Width="*"/>
                                                    <DataGridTextColumn Header="StartHz"    Binding="{Binding StartFreq,   StringFormat={}{0:F7}}" Width="*"/>
                                                    <DataGridTextColumn Header="EndHz"      Binding="{Binding EndFreq,     StringFormat={}{0:F7}}" Width="*"/>
                                                    <DataGridTextColumn Header="Display"    Binding="{Binding DisplayBand, StringFormat={}{0:F7}}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </GroupBox>

                                        <!-- 스케일 -->
                                        <GroupBox Header="그램 전시 파라미터" Margin="0,0,0,8">
                                            <UniformGrid Columns="2" Margin="8">
                                                <TextBlock Text="AScale"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.AScale, StringFormat={}{0:F7}}"/>

                                                <TextBlock Text="BScale"/>
                                                <TextBlock Text="{Binding SelectedPackage.ParsedSet.BScale, StringFormat={}{0:F7}}"/>
                                            </UniformGrid>
                                        </GroupBox>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- 3) Column3: PreciseDir top content -->
                    <GroupBox Grid.Column="2" Header="정밀분석 폴더" Margin="10,0,0,0">
                        <DataGrid ItemsSource="{Binding SelectedPackage.PreciseItems}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="이름(상대)" Binding="{Binding RelativePath}" Width="auto"/>
                                <DataGridTextColumn Header="Dir" Binding="{Binding IsDirectory}" Width="auto"/>
                                <DataGridTextColumn Header="크기" Binding="{Binding Length}" Width="auto"/>
                                <DataGridTextColumn Header="수정" Binding="{Binding LastWriteTime}" Width="auto"/>
                                <DataGridTextColumn Header="전체경로" Binding="{Binding FullPath}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- 4) Column4: Parsed results (fea/dat/cla tabs) -->
                    <GroupBox Grid.Column="3" Header="파싱 결과(.fea/.dat/.cla)" Margin="10,0,0,0">
                        <TabControl>
                            <TabItem Header="nb_식별결과.fea">
                                <Grid Margin="8">
                                    <TextBlock Opacity="0.8" Text="{Binding SelectedPackage.FeaPath, TargetNullValue=(fea 없음)}"/>
                                    <DataGrid ItemsSource="{Binding SelectedPackage.ParsedFea.Features}" AutoGenerateColumns="True" IsReadOnly="True"/>
                                </Grid>
                            </TabItem>
                            <TabItem Header="식별파라미터.dat">
                                <Grid Margin="8">
                                    <TextBlock Opacity="0.8" Text="{Binding SelectedPackage.DatPath, TargetNullValue=(dat 없음)}"/>
                                    <DataGrid ItemsSource="{Binding SelectedPackage.ParsedDat}" AutoGenerateColumns="True" IsReadOnly="True"/>
                                </Grid>
                            </TabItem>
                            <TabItem Header="nb_식별결과.cla">
                                <Grid Margin="8">
                                    <TextBlock Opacity="0.8" Text="{Binding SelectedPackage.ClaPath, TargetNullValue=(cla 없음)}"/>
                                    <DataGrid ItemsSource="{Binding SelectedPackage.ParsedCla.HypResults}" AutoGenerateColumns="True" IsReadOnly="True"/>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </GroupBox>

                    <!-- 5) Column5: Snippets / SnpTmp -->
                    <GroupBox Grid.Column="4" Header="Snippets / SnpTmp" Margin="10,0,0,0">
                        <TabControl>
                            <TabItem Header="Snippets">
                                <DataGrid ItemsSource="{Binding SelectedPackage.Snippets}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="BaseName" Binding="{Binding BaseName}" Width="auto"/>
                                        <DataGridTextColumn Header="Wav" Binding="{Binding WavPath}" Width="*"/>
                                        <DataGridTextColumn Header="Grm" Binding="{Binding GrmPath}" Width="*"/>
                                        <DataGridTextColumn Header="Complete" Binding="{Binding IsComplete}" Width="auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem Header="SnpTmp">
                                <DataGrid ItemsSource="{Binding SelectedPackage.TmpSnippets}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="BaseName" Binding="{Binding BaseName}" Width="auto"/>
                                        <DataGridTextColumn Header="Wav" Binding="{Binding WavPath}" Width="*"/>
                                        <DataGridTextColumn Header="Grm" Binding="{Binding GrmPath}" Width="*"/>
                                        <DataGridTextColumn Header="Complete" Binding="{Binding IsComplete}" Width="auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                        </TabControl>
                    </GroupBox>
                </Grid>
            </Grid>
        </DataTemplate>


        <!-- 3 탭: 단주기원음자료(sd 패키지 파싱 뷰) -->
        <DataTemplate DataType="{x:Type sdvm:ShortPeriodTabViewModel}">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="경로 선택" Width="90" Margin="0,0,8,0"
                        Command="{Binding SelectRootPathCommand}"/>
                        <Button Content="스캔+파싱" Width="110" Margin="0,0,8,0"
                        Command="{Binding ScanParseCommand}"/>
                        <Button Content="DB Import(TODO)" Width="130" Margin="0,0,8,0"
                        Command="{Binding DbImportCommand}"/>
                        <Button Content="취소" Width="70" Margin="0,0,16,0"
                        Command="{Binding CancelCommand}"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding RootPath}" Opacity="0.8"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <ProgressBar Height="18" Width="300" Minimum="0" Maximum="1"
                             Value="{Binding Progress}" Margin="0,0,10,0"/>
                        <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="3.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: package list -->
                    <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Packages}"
                      SelectedItem="{Binding SelectedPackage}"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Import" Binding="{Binding IsChecked}" Width="auto"/>
                            <DataGridTextColumn Header="상태"    Binding="{Binding Status}"       IsReadOnly="True" Width="auto"/>
                            <DataGridTextColumn Header="패키지"  Binding="{Binding PreciseName}"   IsReadOnly="True" Width="auto"/>
                            <DataGridTextColumn Header="RootWav" Binding="{Binding RootWavCount}"  IsReadOnly="True" Width="auto"/>
                            <DataGridTextColumn Header="SPS Ev"  Binding="{Binding SpsEventCount}" IsReadOnly="True" Width="auto"/>
                            <DataGridTextColumn Header="LST Ev"  Binding="{Binding LstEventCount}" IsReadOnly="True" Width="auto"/>
                            <DataGridTextColumn Header="SET"     Binding="{Binding HasSet}"        IsReadOnly="True" Width="auto"/>
                            <DataGridTextColumn Header="AI Ev"   Binding="{Binding AiEventCount}"  IsReadOnly="True" Width="auto"/>
                            <DataGridTextColumn Header="TR Ev"   Binding="{Binding TrEventCount}"  IsReadOnly="True" Width="auto"/>
                            <DataGridTextColumn Header="에러"    Binding="{Binding Error}"          IsReadOnly="True" Width="auto"/>
                            <DataGridTextColumn Header="경로"    Binding="{Binding SdDir}"          IsReadOnly="True" Width="auto"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Right: details -->
                    <TabControl Grid.Column="1" Margin="10,0,0,0">
                        <TabItem Header="Root WAV(Signal_*)">
                            <DataGrid ItemsSource="{Binding ViewRootSignalWavs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="상대경로" Binding="{Binding RelativePath}" Width="auto"/>
                                    <DataGridTextColumn Header="크기" Binding="{Binding Length}" Width="auto"/>
                                    <DataGridTextColumn Header="수정" Binding="{Binding LastWriteTime}" Width="auto"/>
                                    <DataGridTextColumn Header="전체경로" Binding="{Binding FullPath}" Width="auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>

                        <TabItem Header="SPSlist.txt">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding ViewSpsEvents}"
                                  SelectedItem="{Binding SelectedSpsEvent}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="EventID" Binding="{Binding EventID}" Width="auto"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding DetectingType}" Width="auto"/>
                                        <DataGridTextColumn Header="Start" Binding="{Binding StartTime}" Width="auto"/>
                                        <DataGridTextColumn Header="End" Binding="{Binding EndTime}" Width="auto"/>
                                        <DataGridTextColumn Header="SegCnt" Binding="{Binding SegmentCount}" Width="auto"/>
                                        <DataGridTextColumn Header="DirPath" Binding="{Binding DirPath}" Width="auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <DataGrid Grid.Column="1" Margin="10,0,0,0"
                                  ItemsSource="{Binding ViewSpsSegments}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="SegID" Binding="{Binding SegmentID}" Width="auto"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding DetectingType}" Width="auto"/>
                                        <DataGridTextColumn Header="StartFreq" Binding="{Binding StartFreq}" Width="auto"/>
                                        <DataGridTextColumn Header="EndFreq" Binding="{Binding EndFreq}" Width="auto"/>
                                        <DataGridTextColumn Header="FrameCnt" Binding="{Binding FrameCount}" Width="auto"/>
                                        <DataGridTextColumn Header="Len" Binding="{Binding Length}" Width="auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="이벤트리스트.lst">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <DataGrid Grid.Column="0"
                                  ItemsSource="{Binding ViewLstEvents}"
                                  SelectedItem="{Binding SelectedLstEvent}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="EventID" Binding="{Binding EventID}" Width="auto"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding DetectingType}" Width="auto"/>
                                        <DataGridTextColumn Header="Start" Binding="{Binding StartTime}" Width="auto"/>
                                        <DataGridTextColumn Header="End" Binding="{Binding EndTime}" Width="auto"/>

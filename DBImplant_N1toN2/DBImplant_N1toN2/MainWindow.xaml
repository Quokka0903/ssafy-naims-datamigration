                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>

                                            <GroupBox Grid.Column="0" Header="*.wav" Margin="0,0,6,0">
                                                <DataGrid ItemsSource="{Binding ViewTrSnippetWavs}" AutoGenerateColumns="False" IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="파일" Binding="{Binding RelativePath}" Width="auto"/>
                                                        <DataGridTextColumn Header="크기" Binding="{Binding Length}" Width="auto"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </GroupBox>

                                            <GroupBox Grid.Column="1" Header="*.grm" Margin="6,0,0,0">
                                                <DataGrid ItemsSource="{Binding ViewTrSnippetGrms}" AutoGenerateColumns="False" IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="파일" Binding="{Binding RelativePath}" Width="auto"/>
                                                        <DataGridTextColumn Header="크기" Binding="{Binding Length}" Width="auto"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </GroupBox>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="tr_식별결과.cla">
                                        <DataGrid ItemsSource="{Binding ViewTrClaSegments}" AutoGenerateColumns="False" IsReadOnly="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="EventID" Binding="{Binding EventID}" Width="auto"/>
                                                <DataGridTextColumn Header="SegID" Binding="{Binding SegmentID}" Width="auto"/>
                                                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="auto"/>
                                                <DataGridTextColumn Header="Name" Binding="{Binding TransientName}" Width="auto"/>
                                                <DataGridTextColumn Header="FrameNum" Binding="{Binding FrameNum}" Width="auto"/>
                                                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="auto"/>
                                                <DataGridTextColumn Header="Audio" Binding="{Binding AudioSnippet}" Width="auto"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>

                                    <TabItem Header="tr_식별결과.tmp">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="1*"/>
                                                <RowDefinition Height="1*"/>
                                            </Grid.RowDefinitions>

                                            <GroupBox Grid.Row="0" Header="Event">
                                                <DataGrid ItemsSource="{Binding ViewTrTmpEvents}" AutoGenerateColumns="False" IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="EventID" Binding="{Binding EventID}" Width="auto"/>
                                                        <DataGridTextColumn Header="ConfirmedCnt" Binding="{Binding ConfirmedCount}" Width="auto"/>
                                                        <DataGridTextColumn Header="SegmentCnt" Binding="{Binding SegmentCount}" Width="auto"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </GroupBox>

                                            <GroupBox Grid.Row="1" Header="Segments" Margin="0,6,0,0">
                                                <DataGrid ItemsSource="{Binding ViewTrTmpSegments}" AutoGenerateColumns="False" IsReadOnly="True">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="EventID" Binding="{Binding EventID}" Width="auto"/>
                                                        <DataGridTextColumn Header="SegID" Binding="{Binding SegmentID}" Width="auto"/>
                                                        <DataGridTextColumn Header="Start" Binding="{Binding StartTime}" Width="auto"/>
                                                        <DataGridTextColumn Header="End" Binding="{Binding EndTime}" Width="auto"/>
                                                        <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="auto"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </GroupBox>
                                        </Grid>
                                    </TabItem>
                                </TabControl>

                                <TextBlock Grid.Row="2" Opacity="0.7"
                                   Text="※ TR 폴더 파싱: 순간소음탐지리스트.lst / Snippets / tr_식별결과.cla / tr_식별결과.tmp"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </DataTemplate>


    </Window.Resources>

    <Grid>
        <!-- 단계 전환: SetupViewModel → SetupView / WorkspaceViewModel → WorkspaceView -->
        <ContentControl Content="{Binding CurrentView}"/>
    </Grid>
</Window>

                                                </GroupBox>
                                            </Grid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>

                                <TextBlock Grid.Row="2" Opacity="0.7"
                                   Text="※ AI 폴더 파싱: AI탐지리스트.lst / Snippets / ai_식별결과.cla / ai_식별결과.tmp"/>
                            </Grid>
                        </TabItem>


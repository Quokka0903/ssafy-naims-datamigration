                                                <DataGridTextColumn Header="Sonar" Binding="{Binding SonarName}" Width="auto"/>
                                                <DataGridTextColumn Header="Pulse" Binding="{Binding PulseName}" Width="auto"/>
                                                <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="auto"/>
                                                <DataGridTextColumn Header="SegCnt" Binding="{Binding SegmentCount}" Width="auto"/>
                                                <DataGridTextColumn Header="Gram" Binding="{Binding GramSnippet}" Width="auto"/>
                                                <DataGridTextColumn Header="Audio" Binding="{Binding AudioSnippet}" Width="auto"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </TabItem>

                                    <TabItem Header="ai_식별결과.tmp">

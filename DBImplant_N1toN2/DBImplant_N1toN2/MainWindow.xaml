                                                        <DataGridTextColumn Header="Confirmed Pulse" Binding="{Binding ConfirmedPulseName}" Width="auto"/>
                                                        <DataGridTextColumn Header="Score" Binding="{Binding ConfirmedScore}" Width="auto"/>
                                                        <DataGridTextColumn Header="CandCnt" Binding="{Binding CandidateCount}" Width="auto"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </GroupBox>

                                            <Grid Grid.Row="1" Margin="0,6,0,0">

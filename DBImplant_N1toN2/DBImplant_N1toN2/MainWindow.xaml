                                                    <DataGridTextColumn Header="SegID" Binding="{Binding SegmentID}" Width="auto"/>
                                                    <DataGridTextColumn Header="StartFreq" Binding="{Binding StartFreq}" Width="auto"/>
                                                    <DataGridTextColumn Header="EndFreq" Binding="{Binding EndFreq}" Width="auto"/>
                                                    <DataGridTextColumn Header="Snippet" Binding="{Binding SnippetFileName}" Width="auto"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="Snippets 파일">

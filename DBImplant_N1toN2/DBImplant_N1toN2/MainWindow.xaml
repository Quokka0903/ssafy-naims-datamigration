                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <GroupBox Grid.Column="0" Header="Candidates" Margin="0,0,6,0">
                                                    <DataGrid ItemsSource="{Binding ViewAiTmpCandidates}" AutoGenerateColumns="False" IsReadOnly="True">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="EventID" Binding="{Binding EventID}" Width="auto"/>
                                                            <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="auto"/>
                                                            <DataGridTextColumn Header="Sonar" Binding="{Binding SonarName}" Width="auto"/>
                                                            <DataGridTextColumn Header="Pulse" Binding="{Binding PulseName}" Width="auto"/>
                                                            <DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="auto"/>

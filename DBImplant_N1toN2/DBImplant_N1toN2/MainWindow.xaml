                                                    <DataGridTextColumn Header="Start" Binding="{Binding StartTime}" Width="auto"/>
                                                    <DataGridTextColumn Header="End" Binding="{Binding EndTime}" Width="auto"/>
                                                    <DataGridTextColumn Header="Sonar" Binding="{Binding strSonarName}" Width="auto"/>
                                                    <DataGridTextColumn Header="Pulse" Binding="{Binding strPulseName}" Width="auto"/>
                                                    <DataGridTextColumn Header="Score" Binding="{Binding fScore}" Width="auto"/>
                                                </DataGrid.Columns>
                                            </DataGrid>

                                            <DataGrid Grid.Column="1" Margin="10,0,0,0"
                                              ItemsSource="{Binding ViewAiSegments}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True">

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ════════════════════════════════════════════════════════════════════════
       [가이드:디자인] [찾기:NAIMS2디자인] [찾기:색토큰]
       NAIMS2 디자인 시스템(다크) 팔레트.

       원본 : F:\JKYi\2024\4_NAIMS\NAIMS-II\ComponentKit\Resources\Colors.xaml
              (aeon) NAIMS UX 디자인 가이드 UI v1.3
       ※ 이 파일은 원래 밝은 테마였다. 키 이름은 그대로 두고 값만 NAIMS2 다크로 교체해,
         각 스타일 파일(ButtonStyles/DataGridStyles/…)을 고치지 않고 전 화면이 함께 바뀌게 했다.
         그래서 "Surface"=밝은 면 이라는 원래 뉘앙스는 다크에서 "콘텐츠 면"으로 읽어야 한다.
       ════════════════════════════════════════════════════════════════════════
    -->

    <!-- ============================================================ -->
    <!--  Primary (NAIMS2 Blue)                                       -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#FF3E77C5"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"    Color="#FF3D5F8E"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"   Color="#FFB4DCE9"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#FF3D5F8E"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FF3C4857"/>

    <!-- ============================================================ -->
    <!--  Shell (Header / Sidebar)  — BGDeep / BGBase                 -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="ShellBackgroundBrush"   Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FF333333"/>
    <SolidColorBrush x:Key="SidebarActiveBrush"     Color="#FF3E77C5"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"      Color="#FF3C4857"/>

    <!-- ============================================================ -->
    <!--  Surface (콘텐츠 면)  — BGBase / BGSubtle / BGBase2          -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="SurfaceBrush"        Color="#FF333333"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#FF373737"/>
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="#FF3C3C3C"/>

    <!-- ============================================================ -->
    <!--  Border                                                      -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="BorderBrush"      Color="#FF505050"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#FF3E77C5"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#FF464646"/>

    <!-- ============================================================ -->
    <!--  Text                                                        -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="TextPrimaryBrush"         Color="#FFCACACA"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"       Color="#FF787878"/>
    <SolidColorBrush x:Key="TextDisabledBrush"        Color="#FF505050"/>
    <SolidColorBrush x:Key="TextOnDarkBrush"          Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextOnDarkSecondaryBrush" Color="#FFB4DCE9"/>
    <SolidColorBrush x:Key="TextPlaceholderBrush"     Color="#FF787878"/>

    <!-- ============================================================ -->
    <!--  DataGrid Row Alternation                                    -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="RowAlternate1Brush" Color="#FF333333"/>
    <SolidColorBrush x:Key="RowAlternate2Brush" Color="#FF373737"/>
    <SolidColorBrush x:Key="RowSelectedBrush"   Color="#FF3D5F8E"/>
    <SolidColorBrush x:Key="RowHoverBrush"      Color="#FF3C4857"/>

    <!-- ============================================================ -->
    <!--  Semantic (NAIMS2 Accent)                                    -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="ErrorBrush"   Color="#FFFF7B7B"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF3CCFB4"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9900"/>
    <SolidColorBrush x:Key="InfoBrush"    Color="#FFB4DCE9"/>

    <!-- ============================================================ -->
    <!--  Overlay / Scrim                                             -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="ScrimBrush"       Color="#A6000000"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

    <!-- ============================================================ -->
    <!--  Shared Effects                                              -->
    <!-- ============================================================ -->
    <DropShadowEffect x:Key="DropShadowSmall"
                      Color="#60000000"
                      BlurRadius="6"
                      ShadowDepth="1"
                      Direction="270"/>

    <DropShadowEffect x:Key="DropShadowPopup"
                      Color="#60000000"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"/>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!--  Primary Accent (Teal-Cyan)                                  -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="PrimaryBrush"        Color="#FF17C4CF"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"    Color="#FF0EA8B3"/>
    <SolidColorBrush x:Key="PrimaryLightBrush"   Color="#FF4DD8E0"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush"   Color="#FF1AD0DB"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FF0C9AA4"/>

    <!-- ============================================================ -->
    <!--  Dark Shell (Header / Sidebar)                               -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="ShellBackgroundBrush"   Color="#FF1B3040"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FF162737"/>
    <SolidColorBrush x:Key="SidebarActiveBrush"     Color="#FF17C4CF"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"      Color="#FF1E3A50"/>

    <!-- ============================================================ -->
    <!--  Surface (Content Area)                                      -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="SurfaceBrush"        Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="#FFF5F7F8"/>
    <SolidColorBrush x:Key="SurfaceOverlayBrush" Color="#FFF0F4F6"/>

    <!-- ============================================================ -->
    <!--  Border                                                      -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="BorderBrush"      Color="#FFD0D7DC"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#FF17C4CF"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="#FFE8EDEF"/>

    <!-- ============================================================ -->
    <!--  Text                                                        -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="TextPrimaryBrush"         Color="#FF2C3E50"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"       Color="#FF637381"/>
    <SolidColorBrush x:Key="TextDisabledBrush"        Color="#FFAABBC5"/>
    <SolidColorBrush x:Key="TextOnDarkBrush"          Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TextOnDarkSecondaryBrush" Color="#FFB0C8D4"/>
    <SolidColorBrush x:Key="TextPlaceholderBrush"     Color="#FFA0AEB8"/>

    <!-- ============================================================ -->
    <!--  DataGrid Row Alternation                                    -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="RowAlternate1Brush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="RowAlternate2Brush" Color="#FFF0F6F8"/>
    <SolidColorBrush x:Key="RowSelectedBrush"   Color="#FFD4F0F4"/>
    <SolidColorBrush x:Key="RowHoverBrush"      Color="#FFE8F8FA"/>

    <!-- ============================================================ -->
    <!--  Semantic                                                    -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="ErrorBrush"   Color="#FFE53935"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF43A047"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFB8C00"/>
    <SolidColorBrush x:Key="InfoBrush"    Color="#FF17C4CF"/>

    <!-- ============================================================ -->
    <!--  Overlay / Scrim                                             -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="ScrimBrush"       Color="#80000000"/>
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent"/>

    <!-- ============================================================ -->
    <!--  Shared Effects                                              -->
    <!-- ============================================================ -->
    <DropShadowEffect x:Key="DropShadowSmall"
                      Color="#40000000"
                      BlurRadius="6"
                      ShadowDepth="1"
                      Direction="270"/>

    <DropShadowEffect x:Key="DropShadowPopup"
                      Color="#40000000"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"/>

</ResourceDictionary>

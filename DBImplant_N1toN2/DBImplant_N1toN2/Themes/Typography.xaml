<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================ -->
    <!--  Font Families                                               -->
    <!-- ============================================================ -->
    <FontFamily x:Key="PrimaryFont">Noto Sans KR, Malgun Gothic, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, Courier New, monospace</FontFamily>

    <!-- ============================================================ -->
    <!--  Font Sizes  (최솟값 14px)                                   -->
    <!-- ============================================================ -->
    <sys:Double x:Key="FontSizeXSmall">14</sys:Double>
    <sys:Double x:Key="FontSizeSmall">14</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeBodyLarge">14</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">16</sys:Double>
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeHeading">20</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">24</sys:Double>

    <!-- ============================================================ -->
    <!--  Text Styles                                                 -->
    <!-- ============================================================ -->

    <Style x:Key="TextBodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="LineHeight"   Value="22"/>
    </Style>

    <Style x:Key="TextSecondaryStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBodyStyle}">
        <Setter Property="FontSize"   Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style x:Key="TextSidebarStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize"    Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextOnDarkBrush}"/>
    </Style>

    <Style x:Key="TextTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeTitle}"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="TextDialogTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeSubtitle}"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextOnDarkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TextAppTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeHeading}"/>
        <Setter Property="FontWeight"   Value="Bold"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextOnDarkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TextSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"  Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize"    Value="{DynamicResource FontSizeBodyLarge}"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin"      Value="8,0,0,0"/>
    </Style>

    <Style x:Key="TextColumnHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"   Value="{DynamicResource PrimaryFont}"/>
        <Setter Property="FontSize"     Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>

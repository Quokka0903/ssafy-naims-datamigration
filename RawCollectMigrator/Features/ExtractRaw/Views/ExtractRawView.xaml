<UserControl x:Class="RawCollectMigrator.Features.ExtractRaw.ExtractRawView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="🎧 발췌 원음 자료 → DB 마이그레이션"
                       FontSize="18" FontWeight="Bold"/>
            <Border Grid.Column="1" Background="#553322" BorderBrush="#aa5522" BorderThickness="1"
                    Padding="10,4" CornerRadius="3">
                <TextBlock Text="🚧 이관 대상: 원음 + 보조정보 + (단주기) 이벤트/세그먼트 인덱스. 행 더블클릭 = 파싱 결과."
                           Foreground="#ffcc88" FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- [NAIMS-ISSUE:TARGET-CONNSTR] 적재 대상은 이 화면이 갖지 않는다.
             AppSession(시작 화면)의 값을 쓰며, 상단 접속 바에서 확인·변경한다. -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
            <TextBlock x:Name="TargetInfoText" FontSize="11"
                       FontFamily="{StaticResource FontFamily_Mono}"
                       Foreground="{StaticResource BrushTextHelp}" TextWrapping="Wrap"/>
        </Border>

        <!-- 이관 실행 바 -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="이관 대상:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock x:Name="MigTargetInfo" Text="현재 탭에서 선택된 항목" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextHelp}" FontSize="11" Margin="8,0,0,0"/>
                    <CheckBox x:Name="MigSkipDup" Content=" 중복 건너뛰기" IsChecked="True"
                              Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="16,0,0,0"
                              ToolTip="PREC_SRC_SIG_NAME 이 이미 존재하면 이관하지 않습니다."/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" x:Name="BtnMigPreflight" Content="🩺 사전 점검" Click="OnMigPreflight"
                            Padding="12,5"/>
                    <Button Style="{StaticResource WarningButton}" x:Name="BtnMigTrial" Content="🧪 시험 실행" Click="OnMigDryRun" Margin="6,0,0,0"
                            Padding="12,5"/>
                    <Button Style="{StaticResource SuccessButton}" x:Name="BtnMigrate" Content="▶ 이관 실행" Click="OnMigRun" Margin="6,0,0,0"
                            Padding="14,5"/>
                    <Button Style="{StaticResource DangerButton}" x:Name="BtnMigCancel" Content="■ 취소" Click="OnMigCancel" Margin="6,0,0,0"
                            Padding="10,5" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 진행 표시 -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Padding="10,5" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="MigProgressText" Text="대기" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ProgressBar Grid.Column="1" x:Name="MigProgressBar" Minimum="0" Maximum="100" Height="18"
                             Background="{StaticResource BrushBGDeep}" Foreground="{StaticResource BrushPrimary}"/>
                <TextBlock Grid.Column="2" x:Name="MigProgressPct" Text="0 %" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="4" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}">

            <!-- ══════════ 협대역 ══════════ -->
            <TabItem Header="협대역원음자료  (Signal.wav + 보조정보.alg)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="협대역 경로:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="NbPathBox" Margin="6,0"/>
                            <Button Grid.Column="2" Content="📁 변경" Click="OnSelectNbFolder" Width="80"/>
                            <Button Style="{StaticResource PrimaryButton}" Grid.Column="3" Content="🔍 스캔" Click="OnScanNb" Margin="6,0,0,0"
                                   />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <CheckBox x:Name="NbIncludeEmpty" Content=" 빈 폴더 포함"
                                          Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                          Checked="OnNbIncludeEmptyChanged" Unchecked="OnNbIncludeEmptyChanged"/>
                                <Button Content="✅ 전체 선택" Click="OnNbSelectAll" Margin="12,0,0,0" Padding="10,4"
                                        ToolTip="현재 목록에서 이관 가능한 항목을 모두 선택합니다."/>
                                <Button Content="❌ 전체 해제" Click="OnNbSelectNone" Margin="4,0,0,0" Padding="10,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="8,4" Margin="0,0,0,4">
                        <TextBlock x:Name="NbSummary" Text="대기" FontSize="12"/>
                    </Border>

                    <DataGrid Grid.Row="2" x:Name="NbGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single"
                              RowDetailsVisibilityMode="Collapsed"
                              PreviewMouseDoubleClick="OnRowDoubleClickNb">
                        <DataGrid.Columns>
                            <!-- IsReadOnly 그리드에서도 조작되도록 TemplateColumn 사용 -->
                            <DataGridTemplateColumn Header="대상" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsReady}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="항목 폴더명"   Binding="{Binding ItemName}"      Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="Signal.wav"   Binding="{Binding WavCountText}"  Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="원음 크기"     Binding="{Binding SizeText}"      Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="보조정보.alg" Binding="{Binding AlgText}"       Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="DMF (수집체계)" Binding="{Binding DmfText}"      Width="Auto" MinWidth="90"/>
                            <DataGridTextColumn Header="상태"          Binding="{Binding StatusText}"    Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="수정일"        Binding="{Binding LastWriteTime, StringFormat=yyyy-MM-dd HH:mm}" Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="이관"          Binding="{Binding MigStatus}"     Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="이관 결과"     Binding="{Binding MigResultText}" Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="경로"          Binding="{Binding ItemPath}"      Width="*" MinWidth="200"/>
                        </DataGrid.Columns>

                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBGSubtle}" Padding="12"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="📄 보조정보.alg 파싱 결과"
                                                   FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,0,0,6"/>
                                        <ContentControl Grid.Row="1" Height="360"
                                                        Content="{Binding Supplement}"
                                                        ContentTemplate="{StaticResource SupplementDetailTemplate}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══════════ 단주기 ══════════ -->
            <TabItem Header="단주기원음자료  (Signal_*.wav + SPSlist + 이벤트리스트.lst + 보조정보.alg)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="단주기 경로:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="SdPathBox" Margin="6,0"/>
                            <Button Grid.Column="2" Content="📁 변경" Click="OnSelectSdFolder" Width="80"/>
                            <Button Style="{StaticResource PrimaryButton}" Grid.Column="3" Content="🔍 *.sd 스캔" Click="OnScanSd" Margin="6,0,0,0"
                                   />
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <CheckBox x:Name="SdIncludeEmpty" Content=" 빈 폴더 포함"
                                          Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                          Checked="OnSdIncludeEmptyChanged" Unchecked="OnSdIncludeEmptyChanged"/>
                                <Button Content="✅ 전체 선택" Click="OnSdSelectAll" Margin="12,0,0,0" Padding="10,4"
                                        ToolTip="현재 목록에서 이관 가능한 항목을 모두 선택합니다."/>
                                <Button Content="❌ 전체 해제" Click="OnSdSelectNone" Margin="4,0,0,0" Padding="10,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="8,4" Margin="0,0,0,4">
                        <TextBlock x:Name="SdSummary" Text="대기" FontSize="12"/>
                    </Border>

                    <DataGrid Grid.Row="2" x:Name="SdGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" SelectionMode="Single"
                              RowDetailsVisibilityMode="Collapsed"
                              PreviewMouseDoubleClick="OnRowDoubleClickSd">
                        <DataGrid.Columns>
                            <!-- IsReadOnly 그리드에서도 조작되도록 TemplateColumn 사용 -->
                            <DataGridTemplateColumn Header="대상" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsReady}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="*.sd 폴더명"      Binding="{Binding ItemName}"      Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="Signal_*.wav"    Binding="{Binding WavCountText}"  Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="원음 크기"        Binding="{Binding SizeText}"      Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="SPSlist (이벤트)" Binding="{Binding SpsText}"       Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="이벤트리스트"    Binding="{Binding EvtText}"       Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="세그먼트 수"      Binding="{Binding SegText}"       Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="보조정보.alg"    Binding="{Binding AlgText}"       Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="DMF (수집체계)"  Binding="{Binding DmfText}"       Width="Auto" MinWidth="90"/>
                            <DataGridTextColumn Header="상태"             Binding="{Binding StatusText}"    Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="수정일"           Binding="{Binding LastWriteTime, StringFormat=yyyy-MM-dd HH:mm}" Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="이관"             Binding="{Binding MigStatus}"     Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="이관 결과"        Binding="{Binding MigResultText}" Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="경로"             Binding="{Binding ItemPath}"      Width="*" MinWidth="200"/>
                        </DataGrid.Columns>

                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBGSubtle}" Padding="12"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
                                    <TabControl Background="{StaticResource BgBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                Height="420">

                                        <!-- 보조정보 (공용 템플릿) -->
                                        <TabItem Header="📄 보조정보.alg">
                                            <ContentControl Content="{Binding Supplement}"
                                                            ContentTemplate="{StaticResource SupplementDetailTemplate}"/>
                                        </TabItem>

                                        <!-- SPSlist 파싱 결과 -->
                                        <TabItem Header="🔷 SPSlist">
                                            <Grid Margin="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding SpsSummary}"
                                                           Foreground="{StaticResource BrushTextHelp}" FontSize="11" Margin="2,0,0,6"/>
                                                <DataGrid Grid.Row="1" ItemsSource="{Binding SpsEvents}"
                                                          Style="{StaticResource DetailGrid}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="#"         Binding="{Binding Index}"         Width="Auto" MinWidth="80"/>
                                                        <DataGridTextColumn Header="EvtID"     Binding="{Binding EventID}"       Width="Auto" MinWidth="80"/>
                                                        <DataGridTextColumn Header="Type"      Binding="{Binding DetectingType}" Width="Auto" MinWidth="80"/>
                                                        <DataGridTextColumn Header="세그먼트"  Binding="{Binding SegCountText}"  Width="Auto" MinWidth="80"/>
                                                        <DataGridTextColumn Header="수동/자동" Binding="{Binding ManualOrAuto}"  Width="Auto" MinWidth="80"/>
                                                        <DataGridTextColumn Header="DirPath"   Binding="{Binding DirPath}"       Width="*" MinWidth="200"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </TabItem>

                                        <!-- 이벤트리스트.lst 파싱 결과 -->
                                        <TabItem Header="🔶 이벤트리스트.lst">
                                            <Grid Margin="6">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0" Background="{StaticResource BrushBGDeep}" Padding="10" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding LstHeaderSummary}"
                                                               FontFamily="Consolas" FontSize="11" Foreground="#c0c0c0"/>
                                                </Border>

                                                <TextBlock Grid.Row="1" Text="{Binding LstSummary}"
                                                           Foreground="{StaticResource BrushTextHelp}" FontSize="11" Margin="2,0,0,6"/>

                                                <DataGrid Grid.Row="2" ItemsSource="{Binding LstEvents}"
                                                          Style="{StaticResource DetailGrid}"
                                                          RowDetailsVisibilityMode="VisibleWhenSelected">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="#"        Binding="{Binding Index}"         Width="Auto" MinWidth="80"/>
                                                        <DataGridTextColumn Header="EvtID"    Binding="{Binding EventID}"       Width="Auto" MinWidth="80"/>
                                                        <DataGridTextColumn Header="Type"     Binding="{Binding DetectingType}" Width="Auto" MinWidth="80"/>
                                                        <DataGridTextColumn Header="Start"    Binding="{Binding StartTimeText}" Width="Auto" MinWidth="80"/>
                                                        <DataGridTextColumn Header="Length"   Binding="{Binding LengthText}"    Width="Auto" MinWidth="80"/>
                                                        <DataGridTextColumn Header="세그먼트" Binding="{Binding SegmentCount}"  Width="Auto" MinWidth="80"/>
                                                        <DataGridTextColumn Header="Comment"  Binding="{Binding Comment}"       Width="*" MinWidth="200"/>
                                                    </DataGrid.Columns>
                                                    <DataGrid.RowDetailsTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{StaticResource BrushBGDeep}" Padding="8">
                                                                <Grid>
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <TextBlock Grid.Row="0" Text="  ↳ 세그먼트 목록"
                                                                               FontWeight="Bold" Foreground="{StaticResource BrushSuccess}" Margin="0,0,0,4"/>
                                                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Segments}"
                                                                              Style="{StaticResource DetailGrid}"
                                                                              RowHeight="22" MaxHeight="200"
                                                                              Background="#101020" RowBackground="{StaticResource BrushBGDeep}"
                                                                              AlternatingRowBackground="{StaticResource BrushBGSubtle}">
                                                                        <DataGrid.Columns>
                                                                            <DataGridTextColumn Header="#"          Binding="{Binding Index}"           Width="Auto" MinWidth="80"/>
                                                                            <DataGridTextColumn Header="SegID"      Binding="{Binding SegmentID}"       Width="Auto" MinWidth="80"/>
                                                                            <DataGridTextColumn Header="Type"       Binding="{Binding DetTypeText}"     Width="Auto" MinWidth="80"/>
                                                                            <DataGridTextColumn Header="Frames"     Binding="{Binding FrameCount}"      Width="Auto" MinWidth="80"/>
                                                                            <DataGridTextColumn Header="StartFreq"  Binding="{Binding StartFreqText}"   Width="Auto" MinWidth="80"/>
                                                                            <DataGridTextColumn Header="EndFreq"    Binding="{Binding EndFreqText}"     Width="Auto" MinWidth="80"/>
                                                                            <DataGridTextColumn Header="CenterFreq" Binding="{Binding CenterFreqText}"  Width="Auto" MinWidth="80"/>
                                                                            <DataGridTextColumn Header="BandWidth"  Binding="{Binding BandWidthText}"   Width="Auto" MinWidth="80"/>
                                                                            <DataGridTextColumn Header="Snippet"    Binding="{Binding SnippetFileName}" Width="*" MinWidth="200"/>
                                                                        </DataGrid.Columns>
                                                                    </DataGrid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGrid.RowDetailsTemplate>
                                                </DataGrid>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

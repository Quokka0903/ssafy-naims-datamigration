<UserControl x:Class="RawCollectMigrator.Features.Startup.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,22,28,22" MaxWidth="1100" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 제목 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="NAIMS Data Migrator" Style="{StaticResource TextTitle1}"/>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextHelp}"
                               Text="작업을 시작하기 전에 접속 대상과 파일 경로를 확인합니다. 여기서 정한 값은 수집 원음 · 발췌 원음 · DB→DB 세 작업이 모두 공유합니다."/>
                </StackPanel>

                <!-- ① 타겟 -->
                <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="16,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <Run Text="①" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold"/>
                            <Run Text="  적재 대상 — NAIMS2 (필수)" FontWeight="Medium" FontSize="15"/>
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="접속:" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TargetBox"
                                 TextChanged="OnTargetChanged"/>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="🔎 탐색" Click="OnDiscover" Width="86"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="🔌 연결 확인"
                                    Click="OnVerifyTarget" Width="120" Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- [찾기:접속기억] 한 번 붙어 본 대상은 여기서 고르면 비밀번호까지 완성된다 -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="최근 접속:" VerticalAlignment="Center" Margin="0,0,6,0"
                                       FontSize="11" Foreground="{StaticResource BrushTextHelp}"/>
                            <ComboBox x:Name="TargetRecent" Width="430"
                                      SelectionChanged="OnPickTargetRecent"
                                      ToolTip="고르면 접속문자열이 그대로 채워지고 곧바로 연결을 확인합니다."/>
                            <Button Content="🗑 잊기" Click="OnForgetTarget" Width="80" Margin="6,0,0,0"
                                    ToolTip="이 대상을 목록에서 지웁니다(저장해 둔 비밀번호도 함께 지워집니다)."/>
                        </StackPanel>

                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TargetStatus"
                                   Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource BrushTextHelp}"
                                   Text="연결을 확인해야 작업을 시작할 수 있습니다."/>
                    </Grid>
                </Border>

                <!-- ② 소스 -->
                <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="16,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <Run Text="②" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold"/>
                            <Run Text="  읽는 곳 — 구 NAIMS (DB→DB 이관에만 필요)" FontWeight="Medium" FontSize="15"/>
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="종류:" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <RadioButton x:Name="SrcOracle" Content=" Oracle" GroupName="Kind"
                                         IsChecked="True" VerticalAlignment="Center"
                                         Checked="OnSourceShapeChanged"/>
                            <RadioButton x:Name="SrcMsSql" Content=" MsSQL" GroupName="Kind"
                                         Margin="16,0,0,0" VerticalAlignment="Center"
                                         Checked="OnSourceShapeChanged"/>
                            <Border Width="1" Background="{StaticResource BorderBrush}" Margin="16,2,16,2"/>
                            <TextBlock Text="접속 방식:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ModeCombo" Width="160" SelectedIndex="0"
                                      SelectionChanged="OnSourceModeChanged"
                                      ToolTip="폐쇄망 현행은 ODBC. 12c 소스는 관리형 드라이버로 다이렉트 접속이 되지 않으므로 ODBC 를 써야 합니다.">
                                <ComboBoxItem Content="ODBC (기본)"/>
                                <ComboBoxItem Content="다이렉트 (라이브러리)"/>
                            </ComboBox>
                            <Button Content="↩ 기본값" Click="OnResetSource" Width="90" Margin="16,0,0,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="다이렉트로 전환"
                                    Click="OnToDirect" Width="130" Margin="6,0,0,0"
                                    ToolTip="Oracle 관리형 드라이버로 바꿉니다. DSN 등록·클라이언트 설치·비트수 일치가 전혀 필요 없어 ODBC 문제(IM002)를 원천 회피합니다."/>
                            <Button Content="DSN 없이 접속" Click="OnDsnLess" Width="120" Margin="6,0,0,0"
                                    ToolTip="ODBC 를 유지하되 DSN 대신 드라이버를 직접 지정하는 형태로 바꿉니다."/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="접속:" VerticalAlignment="Center"
                                   Margin="0,8,8,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="SourceBox" Margin="0,8,0,0"
                                 TextChanged="OnSourceChanged"/>
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="8,8,0,0">
                            <Button Content="🔎 탐색" Click="OnDiscover" Width="86"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="🔌 연결 확인" Click="OnVerifySource" Width="120" Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- [찾기:접속기억] 종류·접속방식까지 함께 되살린다 -->
                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                                    Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="최근 접속:" VerticalAlignment="Center" Margin="0,0,6,0"
                                       FontSize="11" Foreground="{StaticResource BrushTextHelp}"/>
                            <ComboBox x:Name="SourceRecent" Width="430"
                                      SelectionChanged="OnPickSourceRecent"
                                      ToolTip="고르면 종류·접속방식·접속문자열이 한꺼번에 채워지고 곧바로 연결을 확인합니다."/>
                            <Button Content="🗑 잊기" Click="OnForgetSource" Width="80" Margin="6,0,0,0"
                                    ToolTip="이 대상을 목록에서 지웁니다(저장해 둔 비밀번호도 함께 지워집니다)."/>
                        </StackPanel>

                        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="SourceStatus"
                                   Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource BrushTextHelp}"
                                   Text="파일 이관(수집·발췌)만 할 경우에는 비워 두어도 됩니다."/>
                    </Grid>
                </Border>

                <!-- ③ 파일 경로 -->
                <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="16,14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                            <Run Text="③" Foreground="{StaticResource BrushPrimary}" FontWeight="Bold"/>
                            <Run Text="  자료 폴더" FontWeight="Medium" FontSize="15"/>
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="MSU 루트:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="MsuBox"/>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                            <Button Content="📁" Click="OnPickMsu" Width="46"/>
                            <Button Content="하위 폴더 채우기" Click="OnDeriveFromMsu" Width="130" Margin="6,0,0,0"
                                    ToolTip="MSU 루트 아래 CLASSIFICATIONDB · 수집원음자료 · 협대역원음자료 · 단주기원음자료 를 자동으로 채웁니다."/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="CLASSIFICATION:" VerticalAlignment="Center" Margin="0,6,0,0"
                                   ToolTip="DB→DB 이관의 스니펫·영상 파일은 이 폴더에서만 찾습니다."/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="ClassBox" Margin="0,6,0,0"
                                 TextChanged="OnPathChanged"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="📁 변경" Click="OnPickClass" Width="100" Margin="8,6,0,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="수집원음자료:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="CollectBox" Margin="0,6,0,0"
                                 TextChanged="OnPathChanged"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="📁 변경" Click="OnPickCollect" Width="100" Margin="8,6,0,0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="협대역원음자료:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="NbBox" Margin="0,6,0,0"
                                 TextChanged="OnPathChanged"/>
                        <Button Grid.Row="4" Grid.Column="2" Content="📁 변경" Click="OnPickNb" Width="100" Margin="8,6,0,0"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="단주기원음자료:" VerticalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="SdBox" Margin="0,6,0,0"
                                 TextChanged="OnPathChanged"/>
                        <Button Grid.Row="5" Grid.Column="2" Content="📁 변경" Click="OnPickSd" Width="100" Margin="8,6,0,0"/>

                        <TextBlock Grid.Row="6" Grid.ColumnSpan="3" x:Name="PathStatus" Margin="0,10,0,0"
                                   TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource BrushTextHelp}"/>
                    </Grid>
                </Border>

                <!-- 저장 옵션 -->
                <Border Grid.Row="4" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="3" Padding="16,12" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="SaveCredChk" Content=" 비밀번호까지 저장 (권장)" VerticalAlignment="Center"
                                  Click="OnSaveCredChanged"
                                  ToolTip="Windows DPAPI(현재 사용자 키)로 암호화해 저장합니다. 평문으로 남는 경로는 없고, 파일을 다른 계정·다른 PC 로 옮겨도 풀리지 않습니다. 끄면 저장해 둔 비밀번호까지 지웁니다."/>
                        <TextBlock VerticalAlignment="Center" Margin="14,0,0,0" FontSize="11"
                                   TextWrapping="Wrap" MaxWidth="820"
                                   Foreground="{StaticResource BrushTextHelp}"
                                   Text="연결에 성공한 대상은 자동으로 기억합니다 — 같은 대상을 다시 고르면 비밀번호까지 채워진 접속문자열이 그대로 들어갑니다. 저장 위치: config\connections.json (현재 설정) · config\endpoints.json (기억한 대상, DPAPI 암호화)."/>
                    </StackPanel>
                </Border>

                <!-- 시작 -->
                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="ReadyText" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{StaticResource BrushTextHelp}" FontSize="12"/>
                    <Button Content="설정만 저장" Click="OnSaveOnly" Width="120" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SuccessButton}" x:Name="BtnStart"
                            Content="▶ 작업 시작" Click="OnStart" Width="160" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

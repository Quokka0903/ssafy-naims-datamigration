<Window x:Class="RawCollectMigrator.Features.DbToDb.MigrationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:db="clr-namespace:RawCollectMigrator.Features.DbToDb"
        Title="✅ 실제 이관 결과 — 소스 ↔ 타겟 레코드 대조"
        Height="780" Width="1400"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- [찾기:불일치셀] 어긋난 셀만 진한 빨강 + 보색 글자. 판단은 대조할 때 이미 끝났고 여기서는 읽기만 한다. -->
        <db:MismatchBrushConverter x:Key="MismatchBrush"/>

        <!-- 일치하지 않는 레코드 = 옅은 빨강. 어느 값이 어긋났는지는 셀 색이 따로 말한다.
             '확인불가/키중복' 은 '다르다' 가 아니라 '모른다' 라 호박색으로 갈라 둔다 —
             못 맞춰 본 것을 틀린 것으로 세면 진짜 불일치가 묻힌다. -->
        <Style x:Key="MatchRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding [판정]}" Value="불일치">
                    <Setter Property="Background" Value="#2B1D1D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding [판정]}" Value="소스에만">
                    <Setter Property="Background" Value="#2B1D1D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding [판정]}" Value="타겟에만">
                    <Setter Property="Background" Value="#2B1D1D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding [판정]}" Value="확인불가">
                    <Setter Property="Background" Value="#2A261B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding [판정]}" Value="키중복">
                    <Setter Property="Background" Value="#2A261B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- [찾기:불일치셀] 테이블별 대조와 <같은 글자색·같은 선택색>을 쓴다.
             SyncCell 을 상속하지는 않는다 — 거기 달린 호버 핸들러는 대조 탭의 좌우 그리드를
             짝지어 칠하는 것이라, 매칭 표에서 부르면 엉뚱한 탭의 셀을 건드리고
             셀 배경에 로컬값을 써서 불일치 표시까지 지운다. 겉모습만 같게 맞춘다. -->
        <Style x:Key="MismatchCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Background">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource MismatchBrush}" ConverterParameter="bg">
                        <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header"/>
                        <Binding RelativeSource="{RelativeSource Self}" Path="DataContext"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <!-- 글자색은 TextElement.Foreground 로 건다.
                 셀 템플릿 안의 글자는 ContentPresenter 가 만드는 TextBlock 이라
                 Control.Foreground 만 걸면 먹지 않는 경우가 있다 — 실측: 빨간 칸의 값이
                 어두운 글자 그대로 남아 읽히지 않았다. 상속되는 속성에 걸어야 확실히 닿는다. -->
            <Setter Property="TextElement.Foreground">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource MismatchBrush}" ConverterParameter="fg">
                        <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header"/>
                        <Binding RelativeSource="{RelativeSource Self}" Path="DataContext"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource MismatchBrush}" ConverterParameter="fg">
                        <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header"/>
                        <Binding RelativeSource="{RelativeSource Self}" Path="DataContext"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource MismatchBrush}" ConverterParameter="bold">
                        <Binding RelativeSource="{RelativeSource Self}" Path="Column.Header"/>
                        <Binding RelativeSource="{RelativeSource Self}" Path="DataContext"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3a6090"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="TextElement.Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- [찾기:미리보기] 행 아래 인라인 전시 -->
        <DataTemplate x:Key="PreviewPanelTpl">
            <StackPanel Margin="0,0,16,10" MaxWidth="660">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#ccccdd" FontSize="11"/>
                <TextBlock Text="{Binding Caption}" Foreground="#9999b0" FontSize="10"
                           TextWrapping="Wrap" Margin="0,1,0,3"/>
                <TextBlock Text="{Binding Error}" Foreground="#ff9a8a" FontSize="10"
                           TextWrapping="Wrap" Margin="0,0,0,3"
                           Visibility="{Binding ErrorVisibility}"/>
                <!-- 눈금은 읽으라고 그린 것이라 축소하지 않는다(Stretch=None). 넘치면 가로로 민다. -->
                <Border Background="#14141a" BorderBrush="#2a2a36" BorderThickness="1"
                        Visibility="{Binding ImageVisibility}" HorizontalAlignment="Left">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  MaxWidth="640" MaxHeight="330">
                        <Image Source="{Binding Image}" Stretch="None"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- 클릭한 행에 파란 테두리. 셀 포커싱(매핑 동기화)은 그대로 두고 '행 표시' 만 얹는다. -->
        <Style x:Key="PickRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="DetailsVisibility" Value="Visible">
                    <Setter Property="BorderBrush" Value="#4A9EFF"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Background" Value="#1B2740"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 좌측 세로 탭용 TabItem 스타일. 앱 기본 템플릿은 상단 탭 전용(하단 테두리 없음)이라 따로 정의한다. -->
        <Style x:Key="SideTab" TargetType="TabItem">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                Padding="10,6"
                                Margin="0,0,4,2">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3a4a70"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3a3a55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 좌우 대조 그리드 공용 셀 스타일: 호버 시 상대편 매핑 셀과 함께 색이 변한다. -->
        <Style x:Key="SyncCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3a6090"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="✅ 실제 이관(커밋) 완료 — 소스 ↔ 타겟 레코드 대조" FontSize="16" FontWeight="Bold"/>
                <TextBlock x:Name="HeaderTotals" Foreground="{StaticResource BrushTextHelp}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="표시 행수" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                <ComboBox x:Name="RowLimitCombo" Width="70" SelectedIndex="1"
                          SelectionChanged="OnRowLimitChanged">
                    <ComboBoxItem Content="50"/>
                    <ComboBoxItem Content="100"/>
                    <ComboBoxItem Content="300"/>
                    <ComboBoxItem Content="500"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <TabControl Grid.Row="1" Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}">

            <!-- ① 전체 요약 — 어떤 테이블이 몇 건씩 어떻게 옮겨졌는지 한 눈에 -->
            <TabItem Header="📊 전체 요약">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="10,8" CornerRadius="3" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock x:Name="OverviewTotals" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="OverviewCheck" Foreground="{StaticResource BrushTextPrimary}" FontSize="12"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="OverviewGrid" Style="{StaticResource DetailGrid}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StateKey}" Value="Error">
                                        <Setter Property="Foreground" Value="#ff6666"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKey}" Value="Mismatch">
                                        <Setter Property="Foreground" Value="#ffaa44"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateKey}" Value="Blocked">
                                        <Setter Property="Foreground" Value="#ff8888"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="상태"        Binding="{Binding StateText}"   Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="소스 테이블"  Binding="{Binding Source}"      Width="Auto" MinWidth="140"/>
                            <DataGridTextColumn Header="→ 타겟"      Binding="{Binding Target}"      Width="Auto" MinWidth="180"/>
                            <DataGridTextColumn Header="소스"        Binding="{Binding SourceRows}"  Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="적재"        Binding="{Binding Inserted}"    Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="재사용"      Binding="{Binding Reused}"      Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="건너뜀"      Binding="{Binding Skipped}"     Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="산출자식"    Binding="{Binding Derived}"     Width="Auto" MinWidth="70"/>
                            <DataGridTextColumn Header="오류"        Binding="{Binding Errors}"      Width="Auto" MinWidth="60"/>
                            <DataGridTextColumn Header="이관 후 타겟" Binding="{Binding TargetNow}"   Width="Auto" MinWidth="90"/>
                            <DataGridTextColumn Header="검산"        Binding="{Binding CheckText}"   Width="*"    MinWidth="220"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="🔄 타겟 행수 새로고침" Click="OnRefreshOverview" Padding="10,5"/>
                        <Button Content="💾 CSV 내보내기" Click="OnExportOverviewCsv" Margin="6,0,0,0" Padding="10,5"/>
                        <TextBlock x:Name="OverviewHint" Foreground="#8888a0" FontSize="11"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="검산: 소스 = 적재 + 재사용 + 건너뜀. 불일치·오류 행은 색으로 표시됩니다."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ② 테이블별 소스↔타겟 레코드 대조 -->
            <TabItem Header="🔍 테이블별 대조">
        <TabControl x:Name="Tabs"
                    TabStripPlacement="Left"
                    SelectionChanged="OnTabSelected"
                    Background="{StaticResource BgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    ItemContainerStyle="{StaticResource SideTab}">

            <!-- 탭 머리: 상태 아이콘 + 소스 테이블 / → 타겟 테이블 (두 줄) -->
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Header}">
                        <TextBlock Text="{Binding StatusIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Result.Source}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TargetLabel}" FontSize="10" Foreground="#8888a0"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <!-- 탭 내용: 건수 요약 + 좌(소스 레코드) ↔ 우(이관 완료 레코드) 대조 + 오류 표본 -->
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="10,8" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding StatsText}" Foreground="{StaticResource BrushTextPrimary}" FontSize="12"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="{Binding MappingSummary}"
                                   Foreground="{StaticResource BrushTextHelp}" FontSize="11" Margin="2,8,0,6" TextWrapping="Wrap"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 좌: 이관 소스 테이블 레코드 -->
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="2,0,0,4" LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <Run Text="📤 소스 — "/><Run Text="{Binding Result.Source, Mode=OneWay}" Foreground="#ffcc88"/>
                                    </TextBlock>
                                    <Button DockPanel.Dock="Right" Content="🖼 선택 레코드 미리보기"
                                            Click="OnPreviewSelected" Padding="10,2" FontSize="11"
                                            ToolTip="선택한 행의 국기·영상·그램을 소스/타겟 양쪽 규약으로 그려 봅니다.&#10;행을 클릭하면 표 안에서 바로 펼쳐집니다."/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" x:Name="SrcGrid"
                                          MouseMove="OnGridHoverMove"
                                          MouseLeave="OnGridHoverLeave" PreviewMouseDoubleClick="OnCompareRowActivated"
                                          PreviewMouseLeftButtonDown="OnRowPicked"
                                          ScrollViewer.ScrollChanged="OnCompareScroll"
                                          RowStyle="{StaticResource PickRow}"
                                          RowDetailsVisibilityMode="Collapsed"
                                          Loaded="OnGridLoaded"
                                          ItemsSource="{Binding SourceView}"
                                          Style="{StaticResource DetailGrid}"
                                          CellStyle="{StaticResource SyncCell}"
                                          AutoGenerateColumns="True"
                                          CanUserSortColumns="False"
                                          SelectionUnit="Cell" SelectionMode="Single"
                                          SelectedCellsChanged="OnCellsChanged">
                                    <DataGrid.RowDetailsTemplate>
                                        <DataTemplate>
                                            <Border Background="#101018" BorderBrush="#4A9EFF"
                                                    BorderThickness="0,0,0,2" Padding="10,8">
                                                <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=SrcPreview}"
                                                              ItemTemplate="{StaticResource PreviewPanelTpl}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </Border>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>
                                </DataGrid>
                            </Grid>

                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                                          Background="{StaticResource BorderBrush}"/>

                            <!-- 우: 이관 완료된 타겟 테이블 레코드 -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,4">
                                    <Run Text="📥 타겟(이관 완료) — "/><Run Text="{Binding Result.Target, Mode=OneWay}" Foreground="#88ccff"/>
                                </TextBlock>
                                <DataGrid Grid.Row="1" x:Name="TgtGrid"
                                          MouseMove="OnGridHoverMove"
                                          MouseLeave="OnGridHoverLeave" PreviewMouseDoubleClick="OnCompareRowActivated"
                                          PreviewMouseLeftButtonDown="OnRowPicked"
                                          ScrollViewer.ScrollChanged="OnCompareScroll"
                                          RowStyle="{StaticResource PickRow}"
                                          RowDetailsVisibilityMode="Collapsed"
                                          Loaded="OnGridLoaded"
                                          ItemsSource="{Binding TargetView}"
                                          Style="{StaticResource DetailGrid}"
                                          CellStyle="{StaticResource SyncCell}"
                                          AutoGenerateColumns="True"
                                          CanUserSortColumns="False"
                                          SelectionUnit="Cell" SelectionMode="Single"
                                          SelectedCellsChanged="OnCellsChanged"
                                          Margin="6,0,0,0">
                                    <DataGrid.RowDetailsTemplate>
                                        <DataTemplate>
                                            <Border Background="#101018" BorderBrush="#4A9EFF"
                                                    BorderThickness="0,0,0,2" Padding="10,8">
                                                <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=TgtPreview}"
                                                              ItemTemplate="{StaticResource PreviewPanelTpl}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </Border>
                                        </DataTemplate>
                                    </DataGrid.RowDetailsTemplate>
                                </DataGrid>
                            </Grid>
                        </Grid>

                        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Background="#2a2030" Padding="8" Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasErrors}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="⚠ 오류 표본" Foreground="{StaticResource ErrBrush}"
                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ErrorsText, Mode=OneWay}" IsReadOnly="True"
                                         MaxHeight="100" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                         Background="Transparent"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
            </TabItem>

            <!-- ③ 레코드 매칭 — 짝지어진 레코드를 한 줄에 하나씩, 핵심 필드까지 대조 -->
            <TabItem Header="🔗 레코드 매칭">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="테이블" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="MatchTableCombo" Width="300"
                                  SelectionChanged="OnMatchTableChanged"
                                  DisplayMemberPath="Header"/>
                        <TextBlock Text="짝 기준" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox x:Name="MatchModeCombo" Width="190"
                                  SelectedIndex="0" SelectionChanged="OnMatchModeChanged"
                                  ToolTip="이번 실행 기록: 이관기가 남긴 (소스 PK → 타겟 RECORD_ID) 짝 — 추정 없음.&#10;DB 간 데이터 비교: 파일명 등 자연키 값으로 맞춤 — 예전에 이관한 DB 를 사후 검증할 때.">
                            <ComboBoxItem Content="이번 실행 기록 (정확)"/>
                            <ComboBoxItem Content="DB 간 데이터 비교"/>
                        </ComboBox>
                        <TextBlock Text="보기" VerticalAlignment="Center" Margin="16,0,6,0"/>
                        <ComboBox x:Name="MatchFilterCombo" Width="130"
                                  SelectedIndex="0" SelectionChanged="OnMatchFilterChanged">
                            <ComboBoxItem Content="전체"/>
                            <ComboBoxItem Content="문제만"/>
                            <ComboBoxItem Content="일치만"/>
                        </ComboBox>
                        <Button Content="↻ 다시 대조" Click="OnMatchReload" Margin="16,0,0,0" Padding="10,3"/>
                        <Button Content="TSV 저장" Click="OnMatchExport" Margin="6,0,0,0" Padding="10,3"/>
                        <Button Content="🖼 선택 레코드 미리보기" Click="OnPreviewSelectedMatch"
                                Margin="16,0,0,0" Padding="10,3"
                                ToolTip="선택한 행의 국기·영상·그램을 소스/타겟 양쪽 규약으로 그려 봅니다."/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" x:Name="MatchSummary" Margin="0,0,0,8"
                               Foreground="#8888a0" FontSize="11" TextWrapping="Wrap"
                               Text="테이블을 고르면 레코드 단위로 대조합니다."/>

                    <!-- [찾기:레코드매칭] 테이블별 대조와 같은 방식 — 좌(소스) ↔ 우(타겟).
                         한 표에 (소스)/(타겟) 열을 번갈아 두면 눈이 가로로 왕복해야 해서
                         무엇과 무엇을 견주는지 놓친다. 같은 것을 보는 화면은 같은 모양이어야 한다.
                         두 표는 같은 행 목록을 공유하므로 n번째 줄끼리 짝이며, 세로 스크롤도 함께 움직인다. -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="MatchSrcHead" Margin="2,0,0,4"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#ffcc88"
                                       Text="📤 소스"/>
                            <DataGrid Grid.Row="1" x:Name="MatchGrid"
                                          MouseMove="OnGridHoverMove"
                                          MouseLeave="OnGridHoverLeave"
                                      PreviewMouseDoubleClick="OnMatchRowActivated"
                                      ScrollViewer.ScrollChanged="OnMatchScroll"
                                      SelectedCellsChanged="OnMatchCellsChanged"
                                      Style="{StaticResource DetailGrid}"
                                      AutoGenerateColumns="True"
                                      AutoGeneratingColumn="OnMatchColumnGenerating"
                                      CanUserSortColumns="False"
                                      SelectionUnit="Cell" SelectionMode="Single"
                                      RowStyle="{StaticResource MatchRow}"
                                      CellStyle="{StaticResource MismatchCell}"
                                      HeadersVisibility="Column"/>
                        </Grid>

                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"
                                      Background="{StaticResource BorderBrush}"/>

                        <Grid Grid.Column="2" Margin="6,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="MatchTgtHead" Margin="2,0,0,4"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#88ccff"
                                       Text="📥 타겟"/>
                            <DataGrid Grid.Row="1" x:Name="MatchTgtGrid"
                                          MouseMove="OnGridHoverMove"
                                          MouseLeave="OnGridHoverLeave"
                                      PreviewMouseDoubleClick="OnMatchRowActivated"
                                      ScrollViewer.ScrollChanged="OnMatchScroll"
                                      SelectedCellsChanged="OnMatchCellsChanged"
                                      Style="{StaticResource DetailGrid}"
                                      AutoGenerateColumns="True"
                                      AutoGeneratingColumn="OnMatchColumnGenerating"
                                      CanUserSortColumns="False"
                                      SelectionUnit="Cell" SelectionMode="Single"
                                      RowStyle="{StaticResource MatchRow}"
                                      CellStyle="{StaticResource MismatchCell}"
                                      HeadersVisibility="Column"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="#8888a0" FontSize="11"
                       Text="셀을 클릭하면 상대편의 매핑 셀이 함께 선택되고, 마우스를 올리면 양쪽이 같이 강조됩니다. 행을 클릭하면 그 행 아래에 국기·영상·그램이 소스/타겟 양쪽 규약으로 펼쳐집니다(더블클릭하면 큰 창)."/>
            <Button Content="닫기" Click="OnClose" Width="100" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="RawCollectMigrator.Features.DbToDb.ConflictResolveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="♻ 멱등 충돌 해결 — 타겟에 이미 있는 행을 유지할지, 덮어쓸지 정합니다"
        Width="1280" Height="780" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="10,8" Margin="0,0,0,10" CornerRadius="3">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#ccccdd">
                    타겟에 이미 부합하는 행이 있는데 <Bold>값이 다른</Bold> 건입니다. 값까지 같은 건은 정할 것이 없어 빠져 있습니다.
                    <LineBreak/>
                    <Bold>기본은 '유지'</Bold> — 지금까지와 똑같이 타겟을 그대로 둡니다. 소스에서 값을 바로잡았다면 '덮어쓰기' 를 고르세요.
                    <LineBreak/>
                    타겟에서 손본 내용이 있다면 덮어쓰기가 그것을 지웁니다. 그래서 도구가 정하지 않고 여기서 묻습니다.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="테이블" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="TableCombo" Width="260" SelectionChanged="OnFilterChanged"/>
                    <TextBlock Text="보기" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="FilterCombo" Width="150" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="전체"/>
                        <ComboBoxItem Content="유지만"/>
                        <ComboBoxItem Content="정한 것만"/>
                    </ComboBox>
                    <TextBlock Text="선택 행 일괄 →" VerticalAlignment="Center" Margin="20,0,6,0"/>
                    <Button Content="유지"     Click="OnBulkKeep"      Margin="0,0,6,0" Padding="12,3"/>
                    <Button Content="덮어쓰기" Click="OnBulkOverwrite" Margin="0,0,6,0" Padding="12,3"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" x:Name="Grid" Style="{StaticResource DetailGrid}"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                      SelectionMode="Extended" HeadersVisibility="Column"
                      SelectionChanged="OnRowSelected"
                      RowHeight="34" MinRowHeight="34" VerticalGridLinesBrush="Transparent">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="4,0"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Action}" Value="overwrite">
                                <Setter Property="Background" Value="#3E2B1D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Action}" Value="value">
                                <Setter Property="Background" Value="#1F3326"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="소스 테이블" Binding="{Binding SourceTable}"    IsReadOnly="True" Width="Auto" MinWidth="130"/>
                    <DataGridTextColumn Header="소스 PK"     Binding="{Binding SourcePk}"       IsReadOnly="True" Width="Auto" MinWidth="90"/>
                    <DataGridTextColumn Header="타겟 ID"     Binding="{Binding TargetRecordId}" IsReadOnly="True" Width="Auto" MinWidth="80"/>
                    <DataGridTextColumn Header="다른 값"     Binding="{Binding DiffSummary}"    IsReadOnly="True" Width="*"    MinWidth="200"/>
                    <DataGridTemplateColumn Header="결정" Width="Auto" MinWidth="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Choices}"
                                          DisplayMemberPath="Label" SelectedValuePath="Action"
                                          SelectedValue="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,2" MinWidth="140"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <Grid Grid.Column="2" Margin="6,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" x:Name="DetailHead" Margin="2,0,0,4" FontSize="12" FontWeight="SemiBold"
                           Foreground="#ffcc88" Text="선택한 행의 달라지는 값"/>
                <DataGrid Grid.Row="1" x:Name="DiffGrid" Style="{StaticResource DetailGrid}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                          HeadersVisibility="Column" RowHeight="28" MinRowHeight="28">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="컬럼"        Binding="{Binding Column}"      IsReadOnly="True" Width="Auto" MinWidth="150"/>
                        <DataGridTextColumn Header="지금 타겟"   Binding="{Binding TargetValue}" IsReadOnly="True" Width="*"    MinWidth="120"/>
                        <DataGridTextColumn Header="소스에서 옴" Binding="{Binding SourceValue}" IsReadOnly="True" Width="*"    MinWidth="120"/>
                        <DataGridTextColumn Header="새 값(직접 입력)" Binding="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*" MinWidth="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Foreground="#9999b0" FontSize="11" TextWrapping="Wrap"
                   Text="'새 값' 을 한 칸이라도 적으면 그 행의 결정이 '새 값 입력' 으로 바뀝니다. 비워 두면 그 컬럼은 소스 값으로 갱신됩니다."/>

        <Grid Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="SummaryText" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="#9999b0" FontSize="11" TextWrapping="Wrap" MaxWidth="800"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="저장" Click="OnSave" Width="110" Margin="0,0,8,0"/>
                <Button Content="취소" Click="OnCancel" Width="90"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<Window x:Class="RawCollectMigrator.Features.DbToDb.EndpointBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔎 연결 탐색 — ODBC · 망 발견 · 스캔 · 접속 판정"
        Height="760" Width="1180"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText"
                   FontSize="15" FontWeight="Bold" Margin="0,0,0,4"
                   Foreground="{StaticResource TextBrush}"
                   Text="연결 탐색"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="11"
                   Foreground="{StaticResource BrushTextHelp}"
                   Text="① 로컬 카탈로그는 부작용이 없습니다. ② 망 발견은 브로드캐스트 1회. ③ 서브넷 스캔은 망 스캔이므로 사전 승인 후 실행하세요. ④ 접속 판정은 입력한 계정으로 1회만 시도하며, 계정 잠김이 관측되면 해당 호스트 시도를 중단합니다."/>

        <!-- 탐색 실행 줄 -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="10,8" Margin="0,0,0,8" CornerRadius="3">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Style="{StaticResource PrimaryButton}" x:Name="BtnLocal" Content="① 로컬 ODBC · TNS" Click="OnScanLocal"
                            Padding="12,5"/>
                    <Button Style="{StaticResource PrimaryButton}" x:Name="BtnBrowser" Content="② 망 자동 발견 (UDP 1434)" Click="OnDiscoverBrowser"
                            Padding="12,5" Margin="8,0,0,0"/>

                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="14,2,14,2"/>

                    <TextBlock Text="③ 대역:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <ComboBox x:Name="CidrBox" Width="180" Margin="6,0,0,0" IsEditable="True"
                              VerticalAlignment="Center"/>
                    <TextBlock Text="포트:" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBox x:Name="PortsBox" Width="140" Margin="6,0,0,0" Text="1433,1521,1522"
                             VerticalAlignment="Center"
                             ToolTip="쉼표로 구분. Oracle 은 1521 이 아닐 수 있습니다(현장 예: 1522) — listener.ora 의 PORT 를 확인하세요."/>
                    <Button Style="{StaticResource WarningButton}" x:Name="BtnScan" Content="서브넷 스캔" Click="OnScanSubnet"
                            Padding="12,5" Margin="8,0,0,0"
                           
                            ToolTip="망 스캔입니다. 실행 전 확인을 받습니다."/>
                    <Button x:Name="BtnStop" Content="■ 중지" Click="OnStop" Padding="10,5"
                            Margin="6,0,0,0" IsEnabled="False"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="④ 접속 판정 —  계정:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBox x:Name="UserBox" Width="130" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="비밀번호:" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource TextBrush}"/>
                    <PasswordBox x:Name="PwdBox" Width="130" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="IntegratedChk" Content=" 통합 인증(MsSQL)" Margin="10,0,0,0"
                              VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="방식:" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource TextBrush}"/>
                    <ComboBox x:Name="ModeCombo" Width="120" Margin="6,0,0,0" SelectedIndex="0"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="자동"/>
                        <ComboBoxItem Content="ODBC"/>
                        <ComboBoxItem Content="다이렉트"/>
                    </ComboBox>
                    <Button Style="{StaticResource SuccessButton}" x:Name="BtnProbe" Content="선택 항목 접속 시험" Click="OnProbe"
                            Padding="12,5" Margin="10,0,0,0"/>
                    <Button Content="잠금 가드 해제" Click="OnClearLock" Padding="10,5" Margin="6,0,0,0"
                            ToolTip="계정 잠금을 실제로 푼 뒤에만 누르세요."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 결과 -->
        <DataGrid Grid.Row="3" x:Name="Grid" Style="{StaticResource DetailGrid}"
                  AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Extended"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Connected">
                            <Setter Property="Foreground" Value="#88cc88"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Locked">
                            <Setter Property="Foreground" Value="#ff6666"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Unreachable">
                            <Setter Property="Foreground" Value="#888888"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="AuthRequired">
                            <Setter Property="Foreground" Value="#ffaa44"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <!-- [찾기:선택체크박스] 공용 DetailGrid 스타일이 IsReadOnly=True 라
                     DataGridCheckBoxColumn 은 편집이 막혀 클릭해도 토글되지 않는다.
                     실제 CheckBox 를 얹은 템플릿 열이라야 한 번 클릭으로 켜진다(발췌 원음 탭과 동일 패턴). -->
                <DataGridTemplateColumn Header="선택" Width="46">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="상태"   Binding="{Binding StateText}" Width="Auto" MinWidth="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="종류"   Binding="{Binding KindText}"  Width="Auto" MinWidth="60" IsReadOnly="True"/>
                <DataGridTextColumn Header="대상"   Binding="{Binding Target}"    Width="Auto" MinWidth="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="출처"   Binding="{Binding Origin}"    Width="Auto" MinWidth="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="버전"   Binding="{Binding Version}"   Width="Auto" MinWidth="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="근거 / 메시지" Binding="{Binding Detail}" Width="*" MinWidth="220" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 진행 -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" Text="대기" VerticalAlignment="Center"
                       Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}"/>
            <ProgressBar Grid.Column="1" x:Name="Progress" Height="14" Minimum="0" Maximum="100"
                         Background="{StaticResource BrushBGDeep}" Foreground="{StaticResource BrushPrimary}"/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="소스로 사용" Click="OnUseAsSource" Width="120" Margin="0,0,8,0"
                   />
            <Button Style="{StaticResource DangerButton}" Content="타겟으로 사용" Click="OnUseAsTarget" Width="120" Margin="0,0,8,0"
                   
                    ToolTip="타겟은 항상 MsSQL 다이렉트입니다."/>
            <Button Content="닫기" Click="OnClose" Width="80"/>
        </StackPanel>
    </Grid>
</Window>

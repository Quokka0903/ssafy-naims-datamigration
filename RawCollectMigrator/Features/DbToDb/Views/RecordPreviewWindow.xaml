<Window x:Class="RawCollectMigrator.Features.DbToDb.RecordPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🖼 레코드 미리보기 — 소스(레거시 파싱) ↔ 타겟(R8 66B 파싱)"
        Width="1500" Height="900" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9999b0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Padding="10,8" Margin="0,0,0,10" CornerRadius="3">
            <StackPanel>
                <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="Bold"/>
                <TextBlock Style="{StaticResource Cap}" Margin="0,4,0,0"
                           Text="왼쪽은 원본 파일을 레거시 규약으로, 오른쪽은 타겟 blob 을 신규(R8) 규약으로 각각 읽어 그립니다. 같은 그림이 나오면 규약이 맞은 것이고, 다르면 어디가 어긋났는지 드러납니다."/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 소스 -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneTitle}"
                               x:Name="SrcTitle" Text="소스 (레거시 파싱)" Foreground="#8ec7ff"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="SrcPanels">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#ccccdd"/>
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Cap}"/>
                                        <TextBlock Text="{Binding Error}" Foreground="#ff9a8a" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Visibility="{Binding ErrorVisibility}"/>
                                        <Border Background="#14141a" BorderBrush="#2a2a36" BorderThickness="1"
                                                Visibility="{Binding ImageVisibility}">
                                            <Image Source="{Binding Image}" Stretch="None"
                                                   HorizontalAlignment="Left"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 타겟 -->
            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneTitle}"
                               x:Name="TgtTitle" Text="타겟 (R8 66B 파싱)" Foreground="#9fe0a0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TgtPanels">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#ccccdd"/>
                                        <TextBlock Text="{Binding Caption}" Style="{StaticResource Cap}"/>
                                        <TextBlock Text="{Binding Error}" Foreground="#ff9a8a" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"
                                                   Visibility="{Binding ErrorVisibility}"/>
                                        <Border Background="#14141a" BorderBrush="#2a2a36" BorderThickness="1"
                                                Visibility="{Binding ImageVisibility}">
                                            <Image Source="{Binding Image}" Stretch="None"
                                                   HorizontalAlignment="Left"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="#8888a0" FontSize="11" TextWrapping="Wrap"/>
            <Button Content="닫기" Click="OnClose" Width="100" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="RawCollectMigrator.Features.DbToDb.MissingFileResolveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📁 파일 부재 해결 — 빈 값으로 실을지, 행을 버릴지, 다른 파일을 쓸지 정합니다"
        Width="1180" Height="720" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="Bold" Margin="0,0,0,6"/>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="10,8" Margin="0,0,0,10" CornerRadius="3">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#ccccdd">
                    레코드는 이 파일을 가리키는데 파일을 찾지 못했습니다.
                    <LineBreak/>
                    <Bold>기본은 '빈 값으로 적재'</Bold> 입니다 — 행은 들어가고 그램·원음·영상 blob 만 비어 있습니다.
                    나중에 파일을 확보해 전량 재구축하면 채워집니다.
                    <LineBreak/>
                    아직 안 받아온 파일이면 그대로 두시고, <Bold>폐기된 자료라면 '행 버림'</Bold> 을 고르세요.
                    도구는 이 둘을 구별할 방법이 없습니다.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="종류" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="KindCombo" Width="200" SelectionChanged="OnFilterChanged"/>
                    <TextBlock Text="보기" VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="FilterCombo" Width="150" SelectedIndex="0" SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="전체"/>
                        <ComboBoxItem Content="빈 값만"/>
                        <ComboBoxItem Content="정한 것만"/>
                    </ComboBox>
                    <TextBlock Text="선택 행 일괄 →" VerticalAlignment="Center" Margin="20,0,6,0"/>
                    <Button Content="빈 값으로 적재" Click="OnBulkEmpty"   Margin="0,0,6,0" Padding="10,3"/>
                    <Button Content="행 버림"        Click="OnBulkDiscard" Margin="0,0,6,0" Padding="10,3"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 셀 안에 콤보가 들어가므로 공용 RowHeight(24)를 덮어쓴다. -->
        <DataGrid Grid.Row="2" x:Name="Grid" Style="{StaticResource DetailGrid}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False"
                  SelectionMode="Extended" HeadersVisibility="Column"
                  RowHeight="34" MinRowHeight="34" VerticalGridLinesBrush="Transparent">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="4,0"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Action}" Value="discard">
                            <Setter Property="Background" Value="#3E2222"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Action}" Value="file">
                            <Setter Property="Background" Value="#1F3326"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="종류"   Binding="{Binding Kind}"     IsReadOnly="True" Width="Auto" MinWidth="110"/>
                <DataGridTextColumn Header="파일명" Binding="{Binding FileName}" IsReadOnly="True" Width="Auto" MinWidth="240"/>
                <DataGridTextColumn Header="참조한 레코드" Binding="{Binding RefText}" IsReadOnly="True" Width="Auto" MinWidth="220"/>

                <DataGridTemplateColumn Header="결정" Width="Auto" MinWidth="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Choices}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Action"
                                      SelectedValue="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,2" MinWidth="160"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="대체 파일" Width="*" MinWidth="260">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="찾기…" Click="OnPickFile"
                                        Padding="8,1" Margin="4,2,0,2"/>
                                <TextBlock Text="{Binding SubstitutePath}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="#9999b0"
                                           ToolTip="{Binding SubstitutePath}"/>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="SummaryText" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Foreground="#9999b0" FontSize="11" TextWrapping="Wrap" MaxWidth="700"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="저장" Click="OnSave" Width="110" Margin="0,0,8,0"/>
                <Button Content="취소" Click="OnCancel" Width="90"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
